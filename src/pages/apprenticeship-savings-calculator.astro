---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Button from '../components/Button.astro';
import CTAFooter from '../components/CTAFooter.astro';
import Footer from '../components/Footer.astro';
import DemoRequestModal from '../components/DemoRequestModal.astro';
import enContent from '../content/en.json';

const lang = 'en';
const currentPath = '/apprenticeship-savings-calculator';
---

<BaseLayout
	title="Apprenticeship Cost Calculator | LearnSlice"
	description="What early contract cancellations and trainer time cost your company, based on BIBB averages, and what better support could save. Calculated instantly."
	lang={lang}
	currentPath={currentPath}
>
	<Header logo={enContent.nav.logo} menu={enContent.nav.menu} cta={enContent.nav.cta} currentLang={lang} currentPath={currentPath} />

	<!-- Hero -->
	<section class="pt-32 pb-12 md:pb-16 px-6 md:px-8">
		<div class="max-w-container mx-auto">
			<div class="max-w-[700px]">
				<span class="section-label mb-4 block">Savings Calculator</span>
				<h1 class="text-display-sm md:text-display text-white mb-4">How much could you save?</h1>
				<p class="text-lg text-muted leading-relaxed max-w-[560px]">See what early contract cancellations and trainer time cost your company, based on official BIBB averages, and what better support could save. All values are editable.</p>
			</div>
		</div>
	</section>

	<!-- Calculator -->
	<section class="py-8 md:py-12 px-6 md:px-8" id="calculator">
		<div class="max-w-container mx-auto">
			<div class="grid grid-cols-1 lg:grid-cols-[380px_1fr] gap-8 lg:gap-12 items-start">

				<!-- Left: Controls -->
				<div class="bg-surface border border-border rounded-xl p-6 md:p-8 flex flex-col gap-8 lg:sticky lg:top-24">
					<div>
						<label class="font-mono text-label uppercase tracking-widest text-muted block mb-3" for="apprentice-count">
							New apprentices per year
						</label>
						<div class="flex items-center gap-4">
							<input
								type="range"
								id="apprentice-count"
								min="1"
								max="50"
								value="5"
								class="calc-slider flex-1 h-1.5 bg-border rounded-full appearance-none cursor-pointer accent-primary"
							/>
							<span class="text-2xl font-bold text-white tabular-nums min-w-[3ch] text-right" id="apprentice-count-display">5</span>
						</div>
					</div>

					<!-- Expandable assumptions -->
					<details class="group" open>
						<summary class="flex items-center gap-2 cursor-pointer select-none text-sm text-muted hover:text-white transition-colors">
							<svg class="w-3.5 h-3.5 transition-transform duration-200 group-open:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M9 5l7 7-7 7"/></svg>
							Adjust assumptions
						</summary>
						<div class="mt-6 flex flex-col gap-5 animate-fadeIn">
							<span class="font-mono text-label uppercase tracking-widest text-muted">BIBB averages</span>
							<div>
								<label class="text-xs text-muted block mb-1.5" for="dropout-rate">Share of contracts cancelled early (%)</label>
								<input type="number" id="dropout-rate" value="29.7" min="0" max="100" step="0.1" class="calc-input w-full bg-dark border border-border rounded-lg px-3 py-2 text-sm text-white focus:border-primary focus:outline-none transition-colors" />
								<p class="text-[11px] text-muted/80 mt-1 m-0 leading-snug">BIBB, 2024, all trades</p>
							</div>
							<div>
								<label class="text-xs text-muted block mb-1.5" for="net-cost-y1">Net training cost in year 1 per apprentice (€)</label>
								<input type="number" id="net-cost-y1" value="11818" min="0" step="100" class="calc-input w-full bg-dark border border-border rounded-lg px-3 py-2 text-sm text-white focus:border-primary focus:outline-none transition-colors" />
								<p class="text-[11px] text-muted/80 mt-1 m-0 leading-snug">BIBB 2022/23, three-year trades: gross cost minus the value of the apprentice's work</p>
							</div>
							<div>
								<label class="text-xs text-muted block mb-1.5" for="staff-cost">Training staff cost per apprentice per year (€)</label>
								<input type="number" id="staff-cost" value="6471" min="0" step="100" class="calc-input w-full bg-dark border border-border rounded-lg px-3 py-2 text-sm text-white focus:border-primary focus:outline-none transition-colors" />
								<p class="text-[11px] text-muted/80 mt-1 m-0 leading-snug">BIBB 2022/23, all trades</p>
							</div>
							<span class="font-mono text-label uppercase tracking-widest text-primary mt-2">Effect of LearnSlice (our assumptions)</span>
							<div>
								<label class="text-xs text-muted block mb-1.5" for="cancel-reduction">Fewer early cancellations (%)</label>
								<input type="number" id="cancel-reduction" value="20" min="0" max="100" step="5" class="calc-input w-full bg-dark border border-border rounded-lg px-3 py-2 text-sm text-white focus:border-primary focus:outline-none transition-colors" />
								<p class="text-[11px] text-muted/80 mt-1 m-0 leading-snug">Our assumption, not a measured result. Adjust to your expectation.</p>
							</div>
							<div>
								<label class="text-xs text-muted block mb-1.5" for="time-reduction">Less trainer time (%)</label>
								<input type="number" id="time-reduction" value="20" min="0" max="100" step="5" class="calc-input w-full bg-dark border border-border rounded-lg px-3 py-2 text-sm text-white focus:border-primary focus:outline-none transition-colors" />
								<p class="text-[11px] text-muted/80 mt-1 m-0 leading-snug">Our assumption, not a measured result. Adjust to your expectation.</p>
							</div>
						</div>
					</details>

					<p class="text-xs text-muted leading-relaxed m-0">Figures refer to one intake in its first training year. Each early cancellation is valued at the net cost of the first training year; the cost of filling the place is already part of the BIBB cost figures. Sources: <a href="https://www.bibb.de/dienst/publikationen/de/21037" class="text-primary hover:underline" target="_blank" rel="noopener">BIBB Datenreport 2026</a> and <a href="https://www.bibb.de/de/pressemitteilung_210430.php" class="text-primary hover:underline" target="_blank" rel="noopener">BIBB cost-benefit survey 2022/23</a>. The LearnSlice effects are our assumptions, not measured results.</p>
				</div>

				<!-- Right: Results -->
				<div class="flex flex-col gap-6">
					<!-- Total savings highlight -->
					<div class="bg-surface border border-border rounded-xl p-8 md:p-10 relative overflow-hidden">
						<div class="absolute inset-0 opacity-[0.04] pointer-events-none" style="background: radial-gradient(ellipse at top right, rgba(124, 92, 252, 1) 0%, transparent 60%);"></div>
						<div class="relative">
							<span class="font-mono text-label uppercase tracking-widest text-primary block mb-2">Estimated annual savings</span>
							<div class="text-5xl md:text-6xl font-bold text-white tracking-tight mb-3" id="total-savings">&euro;0</div>
							<p class="text-sm text-muted m-0">per year with <span id="result-count">5</span> new apprentices</p>
						</div>
					</div>

					<!-- Breakdown cards -->
					<div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-border rounded-xl overflow-hidden">
						<div class="bg-surface p-6 flex flex-col gap-2">
							<span class="font-mono text-label uppercase tracking-widest text-muted">Fewer early cancellations</span>
							<div class="text-2xl font-bold text-white tracking-tight" id="cancel-savings">&euro;0</div>
							<p class="text-xs text-muted m-0 leading-relaxed">Training investment you keep when fewer contracts end early.</p>
						</div>
						<div class="bg-surface p-6 flex flex-col gap-2">
							<span class="font-mono text-label uppercase tracking-widest text-muted">Less trainer time</span>
							<div class="text-2xl font-bold text-white tracking-tight" id="trainer-savings">&euro;0</div>
							<p class="text-xs text-muted m-0 leading-relaxed">Share of the BIBB training staff cost freed up for other work.</p>
						</div>
						<div class="bg-surface p-6 flex flex-col gap-2">
							<span class="font-mono text-label uppercase tracking-widest text-muted">Lost to early cancellations today</span>
							<div class="text-2xl font-bold text-white tracking-tight" id="lost-today">&euro;0</div>
							<p class="text-xs text-muted m-0 leading-relaxed">Net year-one investment in contracts that end early, without any change.</p>
						</div>
					</div>

					<!-- Before / After comparison -->
					<div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-border rounded-xl overflow-hidden">
						<div class="bg-surface p-6">
							<span class="font-mono text-label uppercase tracking-widest text-muted block mb-3">Without LearnSlice</span>
							<div class="flex flex-col gap-3">
								<div class="flex justify-between gap-4 text-sm">
									<span class="text-muted">Early cancellations per intake</span>
									<span class="text-white font-medium tabular-nums" id="cancels-without">0</span>
								</div>
								<div class="flex justify-between gap-4 text-sm">
									<span class="text-muted">Training investment lost</span>
									<span class="text-white font-medium tabular-nums" id="lost-without">&euro;0</span>
								</div>
								<div class="flex justify-between gap-4 text-sm">
									<span class="text-muted">Training staff cost per year</span>
									<span class="text-white font-medium tabular-nums" id="staff-without">&euro;0</span>
								</div>
							</div>
						</div>
						<div class="bg-surface p-6 relative">
							<div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background: radial-gradient(ellipse at top right, rgba(124, 92, 252, 1) 0%, transparent 60%);"></div>
							<span class="font-mono text-label uppercase tracking-widest text-primary block mb-3 relative">With LearnSlice</span>
							<div class="flex flex-col gap-3 relative">
								<div class="flex justify-between gap-4 text-sm">
									<span class="text-muted">Early cancellations per intake</span>
									<span class="text-white font-medium tabular-nums" id="cancels-with">0</span>
								</div>
								<div class="flex justify-between gap-4 text-sm">
									<span class="text-muted">Training investment lost</span>
									<span class="text-white font-medium tabular-nums" id="lost-with">&euro;0</span>
								</div>
								<div class="flex justify-between gap-4 text-sm">
									<span class="text-muted">Training staff cost per year</span>
									<span class="text-white font-medium tabular-nums" id="staff-with">&euro;0</span>
								</div>
							</div>
						</div>
					</div>

					<!-- CTA -->
					<div class="bg-surface border border-border rounded-xl p-6 md:p-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
						<div>
							<p class="text-sm font-medium text-white m-0 mb-1">Want to see where LearnSlice helps?</p>
							<p class="text-xs text-muted m-0">See the tutor on your own training plan in a short demo.</p>
						</div>
						<Button variant="primary" href="#demo-request" class="whitespace-nowrap">
							Book Free Demo
							<svg class="w-4 h-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
						</Button>
					</div>
				</div>
			</div>
		</div>
	</section>

	<CTAFooter headline={enContent.cta.headline} subheadline={enContent.cta.subheadline} button={enContent.cta.button} currentLang={lang} />
	<Footer currentLang={lang} privacyLabel={enContent.footer.privacyLabel} termsLabel={enContent.footer.termsLabel} />
	<DemoRequestModal currentLang={lang} />
</BaseLayout>

<script>
	// All costs from BIBB (Datenreport 2026; cost-benefit survey 2022/23). The two
	// reduction percentages are LearnSlice assumptions and are labelled as such in the UI.
	// Scope: one intake (new apprentices per year) in its first training year.
	function initCalculator() {
		const slider = document.getElementById('apprentice-count') as HTMLInputElement;
		const countDisplay = document.getElementById('apprentice-count-display');
		const resultCount = document.getElementById('result-count');
		const inputs = document.querySelectorAll('.calc-input');

		if (!slider) return;

		// Empty or invalid input counts as 0 (not as the default), so the result
		// always matches what the visitor sees in the fields. Percentages are clamped.
		function num(id: string): number {
			const el = document.getElementById(id) as HTMLInputElement | null;
			const v = el ? parseFloat(el.value) : NaN;
			return Number.isFinite(v) && v > 0 ? v : 0;
		}
		function pct(id: string): number {
			return Math.min(num(id), 100) / 100;
		}

		const money = new Intl.NumberFormat('en-GB', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 });
		const one = new Intl.NumberFormat('en-GB', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
		const fmt = (n: number) => money.format(Math.round(n));

		function calculate() {
			const count = parseInt(slider.value, 10);
			const cancelRate = pct('dropout-rate');
			const netCostY1 = num('net-cost-y1');
			const staffCost = num('staff-cost');
			const cancelReduction = pct('cancel-reduction');
			const timeReduction = pct('time-reduction');

			// Early cancellations: no intermediate rounding, so the cards add up exactly.
			const cancelsWithout = count * cancelRate;
			const cancelsWith = cancelsWithout * (1 - cancelReduction);
			const lostWithout = cancelsWithout * netCostY1;
			const lostWith = cancelsWith * netCostY1;
			const cancelSavings = lostWithout - lostWith;

			// Trainer time: share of the BIBB training staff cost per apprentice.
			const staffWithout = count * staffCost;
			const staffWith = staffWithout * (1 - timeReduction);
			const trainerSavings = staffWithout - staffWith;

			const totalSavings = cancelSavings + trainerSavings;

			const set = (id: string, val: string) => { const e = document.getElementById(id); if (e) e.textContent = val; };
			if (countDisplay) countDisplay.textContent = count.toString();
			if (resultCount) resultCount.textContent = count.toString();

			set('total-savings', fmt(totalSavings));
			set('cancel-savings', fmt(cancelSavings));
			set('trainer-savings', fmt(trainerSavings));
			set('lost-today', fmt(lostWithout));
			set('cancels-without', one.format(cancelsWithout));
			set('cancels-with', one.format(cancelsWith));
			set('lost-without', fmt(lostWithout));
			set('lost-with', fmt(lostWith));
			set('staff-without', fmt(staffWithout));
			set('staff-with', fmt(staffWith));
		}

		slider.addEventListener('input', calculate);
		inputs.forEach(input => input.addEventListener('input', calculate));

		calculate();
	}

	document.addEventListener('DOMContentLoaded', initCalculator);
	document.addEventListener('astro:page-load', initCalculator);
</script>

<style>
	.calc-slider::-webkit-slider-thumb {
		-webkit-appearance: none;
		appearance: none;
		width: 20px;
		height: 20px;
		border-radius: 50%;
		background: #7c5cfc;
		cursor: pointer;
		border: 2px solid #27272a;
		box-shadow: 0 0 0 3px rgba(124, 92, 252, 0.2);
	}

	.calc-slider::-moz-range-thumb {
		width: 20px;
		height: 20px;
		border-radius: 50%;
		background: #7c5cfc;
		cursor: pointer;
		border: 2px solid #27272a;
		box-shadow: 0 0 0 3px rgba(124, 92, 252, 0.2);
	}

	@keyframes fadeIn {
		from { opacity: 0; transform: translateY(-4px); }
		to { opacity: 1; transform: translateY(0); }
	}

	.animate-fadeIn {
		animation: fadeIn 0.2s ease-out;
	}
</style>

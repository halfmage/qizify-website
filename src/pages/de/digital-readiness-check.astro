---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import ReadinessCheck from '../../components/ReadinessCheck.astro';
import Footer from '../../components/Footer.astro';
import ConsultationModal from '../../components/ConsultationModal.astro';
import deContent from '../../content/de.json';

const lang = 'de';
const currentPath = '/de/digital-readiness-check';
const ctaLabel = 'Strategiegespräch buchen';

// FAQ: ungated, indexable, and emitted as FAQPage JSON-LD for semantic/AI-answer
// clarity. Answers stay factual and hedge where the obligation depends on the case.
const faq = [
	{
		q: 'Was ist der AZAV- und BFSG-Digital-Readiness-Check?',
		a: 'Eine kostenlose Selbsteinschätzung in wenigen Minuten: Sie beantworten Fragen zu Unterricht und Selbstlernanteilen, Nachweisen, Barrierefreiheit, KI-Einsatz, Datensouveränität und Förderung. Sie erhalten sofort einen Score und, nach kurzer Eintragung, einen personalisierten Maßnahmenplan mit priorisierten Handlungsfeldern. Die Einschätzung dient der Orientierung und ersetzt keine Rechtsberatung oder AZAV-Prüfung.',
	},
	{
		q: 'Wie trennt die AZAV Unterricht und asynchrone Anteile?',
		a: 'Laut den Empfehlungen des Beirats nach § 182 SGB III zählen asynchrone Anteile seit Juli 2025 nicht zu den Unterrichts- oder Maßnahmestunden und werden gesondert auf dem Zertifikat ausgewiesen. Unterricht setzt eine direkte Interaktion mit den Lehr- und Fachkräften voraus, die im Konzept für einen definierten Zeitraum verbindlich vorgesehen ist. Die bloße Möglichkeit, Kontakt aufzunehmen, reicht nicht.',
	},
	{
		q: 'Ab wann und für wen gilt das BFSG für digitale Lernangebote?',
		a: 'Das Barrierefreiheitsstärkungsgesetz (BFSG) gilt für bestimmte Produkte sowie für bestimmte Dienstleistungen, die nach dem 28. Juni 2025 für Verbraucher erbracht werden, mit Übergangsbestimmungen bis zum 27. Juni 2030. Laut Bundesfachstelle Barrierefreiheit fallen E-Books, die Verbraucher über eine Lernmedienplattform abrufen, darunter, interaktive Lernangebote, die keine elektronische Fassung eines Buches sind, nicht. Eine Plattform kann aber die Bedingungen für Dienstleistungen im elektronischen Geschäftsverkehr erfüllen müssen, zum Beispiel wenn über sie eine Dienstleistung verkauft wird.',
	},
	{
		q: 'Was bedeutet die KI-Kompetenz-Pflicht der EU-KI-Verordnung?',
		a: 'Anbieter und Betreiber von KI-Systemen müssen nach Artikel 4 der KI-Verordnung Maßnahmen ergreifen, um die Entwicklung der KI-Kompetenz ihres Personals zu unterstützen. KI-Systeme für den Zugang zu Bildungseinrichtungen oder die Bewertung von Lernergebnissen stehen in Anhang III, die Pflichten für solche Hochrisiko-Systeme gelten ab dem 2. Dezember 2027.',
	},
	{
		q: 'Welche Förderwege gibt es für die Digitalisierung von Weiterbildung?',
		a: 'Das hängt vom Projekt und vom Fördergeber ab. Klären Sie vorab mit dem jeweiligen Fördergeber, ob ein Vorhaben infrage kommt. Kosten für asynchrone Anteile können laut Beirat in die Gesamtkalkulation einer AZAV-Maßnahme einbezogen werden, sind aber gesondert auszuweisen.',
	},
	{
		q: 'Bleiben meine Daten in Deutschland?',
		a: 'Für datenschutzkonforme, souveräne Lösungen ist die Verarbeitung in Deutschland oder der EU, ein Auftragsverarbeitungsvertrag (AVV) und keine Weitergabe von Lernerdaten an Dritt-Modelle die Grundlage. Der Check selbst erhebt nur die Angaben, die Sie freiwillig eintragen, gemäß unserer Datenschutzerklärung.',
	},
];

const faqPageSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faq.map(({ q, a }) => ({
		'@type': 'Question',
		name: q,
		acceptedAnswer: { '@type': 'Answer', text: a },
	})),
};
---

<BaseLayout
	title="AZAV- & BFSG-Digital-Readiness-Check für Bildungsträger | LearnSlice"
	description="In 3 Minuten sehen Sie, wo Ihr digitales Angebot bei AZAV, BFSG, KI und Datensouveränität steht. Personalisierter Maßnahmenplan, sofort nach dem Check."
	lang={lang}
	currentPath={currentPath}
	breadcrumbTitle="Digital-Readiness-Check"
>
	<Header logo={deContent.nav.logo} menu={deContent.nav.menu} cta={ctaLabel} ctaModalTrigger="project-inquiry" currentLang={lang} currentPath={currentPath} />

	<!-- Hero: kurze Einordnung, dann direkt in den interaktiven Check -->
	<section class="relative overflow-hidden pt-28 md:pt-32 pb-4 md:pb-8 px-6 md:px-8">
		<div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[900px] h-[420px] pointer-events-none glow-aurora opacity-40" aria-hidden="true"></div>
		<div class="max-w-3xl mx-auto relative z-10 text-center">
			<span class="inline-flex items-center gap-1.5 text-xs font-medium text-accent bg-accent/10 border border-accent/30 rounded-full px-3 py-1 mb-5">
				<svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.4 6.4L21 9l-5 4.6L17.6 21 12 17.3 6.4 21 8 13.6 3 9l6.6-.6L12 2z"/></svg>
				BMWE KI-Preis 2025 Gewinner
			</span>
			<h1 class="text-display-sm xl:text-display text-balance text-white mb-5">
				Wo steht Ihr digitales Angebot bei <span class="gradient-text-primary">AZAV, BFSG und KI</span>?
			</h1>
			<p class="text-base md:text-lg text-muted leading-relaxed max-w-2xl mx-auto mb-4">
				Wenige Fragen, 3 Minuten. Sie erhalten einen persönlichen Maßnahmenplan mit konkreten Schritten und passenden Förderwegen.
			</p>
			<div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-xs text-muted">
				<span class="inline-flex items-center gap-1.5">
					<svg class="w-3.5 h-3.5 text-primary flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
					DSGVO-konform
				</span>
				<span class="inline-flex items-center gap-1.5">
					<svg class="w-3.5 h-3.5 text-primary flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
					Infrastruktur in Deutschland
				</span>
				<span class="inline-flex items-center gap-1.5">
					<svg class="w-3.5 h-3.5 text-primary flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
					Entwickelt in Europa
				</span>
			</div>
		</div>
	</section>

	<ReadinessCheck />

	<!-- Ungated, static SEO body: always crawlable, independent of the tool's JS state -->
	<section class="px-6 md:px-8 pb-16 md:pb-24">
		<div class="max-w-3xl mx-auto">
			<h2 class="text-heading-sm md:text-heading text-white mt-0 mb-4">Digital-Readiness für Bildungsträger: AZAV, BFSG und KI im Überblick</h2>
			<p class="text-base text-muted leading-relaxed mb-4">Die Digitalisierung von Aus- und Weiterbildung steht 2026 unter neuen Vorzeichen. Für Bildungsträger, Weiterbildungsanbieter und Reha-Einrichtungen kommen mehrere Anforderungen zusammen: die Empfehlungen des AZAV-Beirats, das Barrierefreiheitsstärkungsgesetz (BFSG) und die EU-KI-Verordnung. Der Digital-Readiness-Check zeigt Ihnen in wenigen Minuten, wo Ihr digitales Angebot heute steht und welche Schritte sich lohnen. Die folgenden Abschnitte fassen zusammen, worauf es ankommt.</p>

			<h2 class="text-heading-sm md:text-heading text-white mt-10 mb-4">AZAV: Unterricht, Selbstlernanteile und Nachweise</h2>
			<p class="text-base text-muted leading-relaxed mb-4">Seit Juli 2025 zählen asynchrone Anteile laut den Empfehlungen des AZAV-Beirats nicht zu den Unterrichts- oder Maßnahmestunden und werden gesondert auf dem Zertifikat ausgewiesen. Zum Qualitätsmanagement nennt der Beirat außerdem die Erfassung von Teilnehmerpräsenz und Abbruchquoten. Eine Erfassung im System kann beides erleichtern. Die Details lesen Sie im Leitfaden <a href="/de/blog/azav-digitalisierung-bildungstraeger" class="text-primary hover:underline">AZAV und Digitalisierung</a>.</p>

			<h2 class="text-heading-sm md:text-heading text-white mt-10 mb-4">BFSG: Was für Lernplattformen gilt</h2>
			<p class="text-base text-muted leading-relaxed mb-4">Das BFSG gilt für bestimmte Produkte sowie für bestimmte Dienstleistungen gegenüber Verbrauchern, mit Übergangsbestimmungen bis zum 27. Juni 2030. Für Lernplattformen muss man laut Bundesfachstelle Barrierefreiheit differenzieren: E-Books für Verbraucher fallen darunter, interaktive Lernangebote, die keine elektronische Fassung eines Buches sind, nicht. Eine Plattform kann aber die Bedingungen für Dienstleistungen im elektronischen Geschäftsverkehr erfüllen müssen. Kleinstunternehmen, die Dienstleistungen anbieten, sind ausgenommen.</p>

			<h2 class="text-heading-sm md:text-heading text-white mt-10 mb-4">EU-KI-Verordnung: KI-Kompetenz und verantwortungsvoller Einsatz</h2>
			<p class="text-base text-muted leading-relaxed mb-4">Anbieter und Betreiber von KI-Systemen müssen nach Artikel 4 der KI-Verordnung Maßnahmen ergreifen, um die Entwicklung der KI-Kompetenz ihres Personals zu unterstützen. KI-Systeme für den Zugang zu Bildungseinrichtungen oder die Bewertung von Lernergebnissen stehen in Anhang III, die Pflichten für solche Hochrisiko-Systeme gelten ab dem 2. Dezember 2027. Ein KI-Lernbegleiter, der ausschließlich aus Ihren geprüften Inhalten antwortet, Quellen belegt und menschliche Aufsicht vorsieht, lässt sich leichter nachvollziehen und kontrollieren. Mehr dazu in unserem Beitrag zu <a href="/de/blog/dsgvo-konforme-ki-tools-fuer-ausbilder" class="text-primary hover:underline">DSGVO-konformen KI-Tools</a>.</p>

			<h2 class="text-heading-sm md:text-heading text-white mt-10 mb-4">Datensouveränität: Verarbeitung in Deutschland und der EU</h2>
			<p class="text-base text-muted leading-relaxed mb-4">Für datenschutzkonforme, souveräne Lösungen sind die Verarbeitung in Deutschland oder der EU, ein Auftragsverarbeitungsvertrag (AVV) und der Verzicht auf die Weitergabe von Lernerdaten an Dritt-Modelle die Grundlage. Wie wir das technisch umsetzen, zeigen unsere <a href="/de/loesungen" class="text-primary hover:underline">Lösungen</a> und die <a href="/de/forschung" class="text-primary hover:underline">Forschung</a> dahinter.</p>

			<h2 class="text-heading-sm md:text-heading text-white mt-10 mb-4">Förderung und Kosten</h2>
			<p class="text-base text-muted leading-relaxed mb-4">Ob für ein Digitalisierungsprojekt Fördermittel infrage kommen, klären Sie vorab mit dem jeweiligen Fördergeber. Kosten für asynchrone Anteile können laut Beirat in die Gesamtkalkulation einer AZAV-Maßnahme einbezogen werden, sind aber gesondert auszuweisen. In einem klar abgegrenzten Pilotprojekt prüfen Sie den Nutzen, bevor Sie sich festlegen. Weitere Praxis finden Sie im Beitrag <a href="/de/blog/ausbildung-digitalisieren" class="text-primary hover:underline">Ausbildung digitalisieren</a>.</p>

			<h2 class="text-heading-sm md:text-heading text-white mt-12 mb-6">Häufige Fragen</h2>
			<div class="flex flex-col gap-3">
				{faq.map(({ q, a }) => (
					<details class="group bg-surface border border-border rounded-xl px-5 py-4">
						<summary class="flex items-center justify-between gap-4 cursor-pointer text-base font-medium text-white list-none marker:hidden [&::-webkit-details-marker]:hidden">
							<span>{q}</span>
							<svg class="w-4 h-4 flex-shrink-0 text-muted transition-transform duration-200 group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
						</summary>
						<p class="text-sm text-muted leading-relaxed mt-3 mb-0">{a}</p>
					</details>
				))}
			</div>

			<p class="text-xs text-muted leading-relaxed mt-8 m-0">Diese Angaben dienen der Orientierung und ersetzen keine Rechtsberatung oder AZAV-Prüfung. Stand der rechtlichen Angaben: November 2026.</p>
		</div>
	</section>

	<script type="application/ld+json" set:html={JSON.stringify(faqPageSchema)} />

	<Footer currentLang={lang} privacyLabel={deContent.footer.privacyLabel} termsLabel={deContent.footer.termsLabel} demoHref="#project-inquiry" />

	<ConsultationModal currentLang={lang} />
</BaseLayout>

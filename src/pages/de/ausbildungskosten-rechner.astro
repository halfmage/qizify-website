---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Button from '../../components/Button.astro';
import CTAFooter from '../../components/CTAFooter.astro';
import Footer from '../../components/Footer.astro';
import DemoRequestModal from '../../components/DemoRequestModal.astro';
import deContent from '../../content/de.json';

const lang = 'de';
const currentPath = '/de/ausbildungskosten-rechner';
---

<BaseLayout
	title="Ausbildungskosten-Rechner für Unternehmen | LearnSlice"
	description="Was vorzeitig gelöste Ausbildungsverträge und Ausbilderzeit Ihr Unternehmen kosten, auf Basis von BIBB-Durchschnitten, und was bessere Begleitung sparen kann."
	lang={lang}
	currentPath={currentPath}
>
	<Header logo={deContent.nav.logo} menu={deContent.nav.menu} cta={deContent.nav.cta} currentLang={lang} currentPath={currentPath} />

	<!-- Hero -->
	<section class="pt-32 pb-12 md:pb-16 px-6 md:px-8">
		<div class="max-w-container mx-auto">
			<div class="max-w-[700px]">
				<span class="section-label mb-4 block">Einsparungsrechner</span>
				<h1 class="text-display-sm md:text-display text-white mb-4">Wie viel k&ouml;nnten Sie sparen?</h1>
				<p class="text-lg text-muted leading-relaxed max-w-[560px]">Sehen Sie, was vorzeitig gel&ouml;ste Ausbildungsvertr&auml;ge und Ausbilderzeit Ihr Unternehmen kosten, auf Basis der offiziellen BIBB-Durchschnitte, und was bessere Begleitung sparen kann. Alle Werte sind anpassbar.</p>
			</div>
		</div>
	</section>

	<!-- Calculator -->
	<section class="py-8 md:py-12 px-6 md:px-8" id="calculator">
		<div class="max-w-container mx-auto">
			<div class="grid grid-cols-1 lg:grid-cols-[380px_1fr] gap-8 lg:gap-12 items-start">

				<!-- Left: Controls -->
				<div class="bg-surface border border-border rounded-xl p-6 md:p-8 flex flex-col gap-8 lg:sticky lg:top-24">
					<div>
						<label class="font-mono text-label uppercase tracking-widest text-muted block mb-3" for="apprentice-count">
							Neue Azubis pro Jahr
						</label>
						<div class="flex items-center gap-4">
							<input
								type="range"
								id="apprentice-count"
								min="1"
								max="50"
								value="5"
								class="calc-slider flex-1 h-1.5 bg-border rounded-full appearance-none cursor-pointer accent-primary"
							/>
							<span class="text-2xl font-bold text-white tabular-nums min-w-[3ch] text-right" id="apprentice-count-display">5</span>
						</div>
					</div>

					<!-- Expandable assumptions -->
					<details class="group" open>
						<summary class="flex items-center gap-2 cursor-pointer select-none text-sm text-muted hover:text-white transition-colors">
							<svg class="w-3.5 h-3.5 transition-transform duration-200 group-open:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M9 5l7 7-7 7"/></svg>
							Annahmen anpassen
						</summary>
						<div class="mt-6 flex flex-col gap-5 animate-fadeIn">
							<span class="font-mono text-label uppercase tracking-widest text-muted">BIBB-Durchschnittswerte</span>
							<div>
								<label class="text-xs text-muted block mb-1.5" for="dropout-rate">Anteil vorzeitig gel&ouml;ster Vertr&auml;ge (%)</label>
								<input type="number" id="dropout-rate" value="29.7" min="0" max="100" step="0.1" class="calc-input w-full bg-dark border border-border rounded-lg px-3 py-2 text-sm text-white focus:border-primary focus:outline-none transition-colors" />
								<p class="text-[11px] text-muted/80 mt-1 m-0 leading-snug">BIBB, 2024, alle Berufe</p>
							</div>
							<div>
								<label class="text-xs text-muted block mb-1.5" for="net-cost-y1">Nettokosten im 1. Ausbildungsjahr pro Azubi (&euro;)</label>
								<input type="number" id="net-cost-y1" value="11818" min="0" step="100" class="calc-input w-full bg-dark border border-border rounded-lg px-3 py-2 text-sm text-white focus:border-primary focus:outline-none transition-colors" />
								<p class="text-[11px] text-muted/80 mt-1 m-0 leading-snug">BIBB 2022/23, dreij&auml;hrige Berufe: Bruttokosten abz&uuml;glich des Werts der Arbeitsleistung des Azubis</p>
							</div>
							<div>
								<label class="text-xs text-muted block mb-1.5" for="staff-cost">Kosten Ausbildungspersonal pro Azubi und Jahr (&euro;)</label>
								<input type="number" id="staff-cost" value="6471" min="0" step="100" class="calc-input w-full bg-dark border border-border rounded-lg px-3 py-2 text-sm text-white focus:border-primary focus:outline-none transition-colors" />
								<p class="text-[11px] text-muted/80 mt-1 m-0 leading-snug">BIBB 2022/23, alle Berufe</p>
							</div>
							<span class="font-mono text-label uppercase tracking-widest text-primary mt-2">Wirkung von LearnSlice (Schätzungen)</span>
							<div>
								<label class="text-xs text-muted block mb-1.5" for="cancel-reduction">Weniger vorzeitige Vertragsl&ouml;sungen (%)</label>
								<input type="number" id="cancel-reduction" value="20" min="0" max="100" step="5" class="calc-input w-full bg-dark border border-border rounded-lg px-3 py-2 text-sm text-white focus:border-primary focus:outline-none transition-colors" />
								<p class="text-[11px] text-muted/80 mt-1 m-0 leading-snug">Unsere Annahme, kein gemessenes Ergebnis. Passen Sie den Wert an Ihre Erwartung an.</p>
							</div>
							<div>
								<label class="text-xs text-muted block mb-1.5" for="time-reduction">Weniger Ausbilderzeit (%)</label>
								<input type="number" id="time-reduction" value="30" min="0" max="100" step="5" class="calc-input w-full bg-dark border border-border rounded-lg px-3 py-2 text-sm text-white focus:border-primary focus:outline-none transition-colors" />
								<div class="flex gap-2 mt-2">
									<button type="button" data-time-preset="30" class="calc-preset text-[11px] px-2.5 py-1 rounded-full border border-border text-muted hover:text-white hover:border-primary transition-colors">30 % konservativ</button>
									<button type="button" data-time-preset="50" class="calc-preset text-[11px] px-2.5 py-1 rounded-full border border-border text-muted hover:text-white hover:border-primary transition-colors">50 % obere Spanne</button>
								</div>
								<p class="text-[11px] text-muted/80 mt-1.5 m-0 leading-snug">Konservative Schätzung aus unseren Kundenprojekten; die Ergebnisse variieren je nach Unternehmen und liegen bei bis zu 50 %.</p>
							</div>
						</div>
					</details>

					<p class="text-xs text-muted leading-relaxed m-0">Die Werte beziehen sich auf einen Ausbildungsjahrgang im ersten Ausbildungsjahr. Jede vorzeitige Vertragsl&ouml;sung wird mit den Nettokosten des ersten Ausbildungsjahres bewertet; die Kosten f&uuml;r die Besetzung der Stelle sind in den BIBB-Kosten bereits enthalten. Quellen: <a href="https://www.bibb.de/dienst/publikationen/de/21037" class="text-primary hover:underline" target="_blank" rel="noopener">BIBB-Datenreport 2026</a> und <a href="https://www.bibb.de/de/pressemitteilung_210430.php" class="text-primary hover:underline" target="_blank" rel="noopener">BIBB-Kosten-Nutzen-Erhebung 2022/23</a>. Die Wirkung von LearnSlice ist geschätzt: 20&nbsp;% weniger vorzeitige Vertragslösungen ist unsere Annahme; 30&nbsp;% weniger Ausbilderzeit ist eine konservative Schätzung aus Kundenprojekten, in denen die Ergebnisse bei bis zu 50&nbsp;% liegen.</p>
				</div>

				<!-- Right: Results -->
				<div class="flex flex-col gap-6">
					<!-- Total savings highlight -->
					<div class="bg-surface border border-border rounded-xl p-8 md:p-10 relative overflow-hidden">
						<div class="absolute inset-0 opacity-[0.04] pointer-events-none" style="background: radial-gradient(ellipse at top right, rgba(124, 92, 252, 1) 0%, transparent 60%);"></div>
						<div class="relative">
							<span class="font-mono text-label uppercase tracking-widest text-primary block mb-2">Gesch&auml;tzte j&auml;hrliche Einsparung</span>
							<div class="text-5xl md:text-6xl font-bold text-white tracking-tight mb-3" id="total-savings">&euro;0</div>
							<p class="text-sm text-muted m-0">pro Jahr bei <span id="result-count">5</span> neuen Azubis</p>
							<p class="text-sm text-muted m-0 mt-2" id="upper-range-line">Mit bis zu 50&nbsp;% weniger Ausbilderzeit: bis zu <span class="text-white font-medium" id="upper-savings">0&nbsp;&euro;</span> pro Jahr.</p>
						</div>
					</div>

					<!-- Breakdown cards -->
					<div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-border rounded-xl overflow-hidden">
						<div class="bg-surface p-6 flex flex-col gap-2">
							<span class="font-mono text-label uppercase tracking-widest text-muted">Weniger vorzeitige Vertragsl&ouml;sungen</span>
							<div class="text-2xl font-bold text-white tracking-tight" id="cancel-savings">&euro;0</div>
							<p class="text-xs text-muted m-0 leading-relaxed">Ausbildungsinvestition, die Sie behalten, wenn weniger Vertr&auml;ge vorzeitig enden.</p>
						</div>
						<div class="bg-surface p-6 flex flex-col gap-2">
							<span class="font-mono text-label uppercase tracking-widest text-muted">Weniger Ausbilderzeit</span>
							<div class="text-2xl font-bold text-white tracking-tight" id="trainer-savings">&euro;0</div>
							<p class="text-xs text-muted m-0 leading-relaxed">Anteil der BIBB-Kosten f&uuml;r Ausbildungspersonal, der f&uuml;r andere Aufgaben frei wird.</p>
						</div>
						<div class="bg-surface p-6 flex flex-col gap-2">
							<span class="font-mono text-label uppercase tracking-widest text-muted">Heute verloren durch vorzeitige L&ouml;sungen</span>
							<div class="text-2xl font-bold text-white tracking-tight" id="lost-today">&euro;0</div>
							<p class="text-xs text-muted m-0 leading-relaxed">Netto-Investition des ersten Jahres in Vertr&auml;ge, die vorzeitig enden, ohne jede Ver&auml;nderung.</p>
						</div>
					</div>

					<!-- Before / After comparison -->
					<div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-border rounded-xl overflow-hidden">
						<div class="bg-surface p-6">
							<span class="font-mono text-label uppercase tracking-widest text-muted block mb-3">Ohne LearnSlice</span>
							<div class="flex flex-col gap-3">
								<div class="flex justify-between gap-4 text-sm">
									<span class="text-muted">Vorzeitige L&ouml;sungen pro Jahrgang</span>
									<span class="text-white font-medium tabular-nums" id="cancels-without">0</span>
								</div>
								<div class="flex justify-between gap-4 text-sm">
									<span class="text-muted">Verlorene Ausbildungsinvestition</span>
									<span class="text-white font-medium tabular-nums" id="lost-without">&euro;0</span>
								</div>
								<div class="flex justify-between gap-4 text-sm">
									<span class="text-muted">Kosten Ausbildungspersonal pro Jahr</span>
									<span class="text-white font-medium tabular-nums" id="staff-without">&euro;0</span>
								</div>
							</div>
						</div>
						<div class="bg-surface p-6 relative">
							<div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background: radial-gradient(ellipse at top right, rgba(124, 92, 252, 1) 0%, transparent 60%);"></div>
							<span class="font-mono text-label uppercase tracking-widest text-primary block mb-3 relative">Mit LearnSlice</span>
							<div class="flex flex-col gap-3 relative">
								<div class="flex justify-between gap-4 text-sm">
									<span class="text-muted">Vorzeitige L&ouml;sungen pro Jahrgang</span>
									<span class="text-white font-medium tabular-nums" id="cancels-with">0</span>
								</div>
								<div class="flex justify-between gap-4 text-sm">
									<span class="text-muted">Verlorene Ausbildungsinvestition</span>
									<span class="text-white font-medium tabular-nums" id="lost-with">&euro;0</span>
								</div>
								<div class="flex justify-between gap-4 text-sm">
									<span class="text-muted">Kosten Ausbildungspersonal pro Jahr</span>
									<span class="text-white font-medium tabular-nums" id="staff-with">&euro;0</span>
								</div>
							</div>
						</div>
					</div>

					<!-- CTA -->
					<div class="bg-surface border border-border rounded-xl p-6 md:p-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
						<div>
							<p class="text-sm font-medium text-white m-0 mb-1">Sehen, wo LearnSlice hilft?</p>
							<p class="text-xs text-muted m-0">Erleben Sie den Tutor in einer kurzen Demo an Ihrem eigenen Ausbildungsplan.</p>
						</div>
						<Button variant="primary" href="#demo-request" class="whitespace-nowrap">
							Kostenlose Demo buchen
							<svg class="w-4 h-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
						</Button>
					</div>
				</div>
			</div>
		</div>
	</section>

	<CTAFooter headline={deContent.cta.headline} subheadline={deContent.cta.subheadline} button={deContent.cta.button} currentLang={lang} />
	<Footer currentLang={lang} privacyLabel={deContent.footer.privacyLabel} termsLabel={deContent.footer.termsLabel} />
	<DemoRequestModal currentLang={lang} />
</BaseLayout>

<script>
	// All costs from BIBB (Datenreport 2026; cost-benefit survey 2022/23). The two
	// reduction percentages are LearnSlice assumptions and are labelled as such in the UI.
	// Trainer time: 30% conservative default, customer results range up to 50%.
	// Scope: one intake (new apprentices per year) in its first training year.
	function initCalculator() {
		const slider = document.getElementById('apprentice-count') as HTMLInputElement;
		const countDisplay = document.getElementById('apprentice-count-display');
		const resultCount = document.getElementById('result-count');
		const inputs = document.querySelectorAll('.calc-input');

		if (!slider) return;

		// Empty or invalid input counts as 0 (not as the default), so the result
		// always matches what the visitor sees in the fields. Percentages are clamped.
		function num(id: string): number {
			const el = document.getElementById(id) as HTMLInputElement | null;
			const v = el ? parseFloat(el.value) : NaN;
			return Number.isFinite(v) && v > 0 ? v : 0;
		}
		function pct(id: string): number {
			return Math.min(num(id), 100) / 100;
		}

		const money = new Intl.NumberFormat('de-DE', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 });
		const one = new Intl.NumberFormat('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
		const fmt = (n: number) => money.format(Math.round(n));

		function calculate() {
			const count = parseInt(slider.value, 10);
			const cancelRate = pct('dropout-rate');
			const netCostY1 = num('net-cost-y1');
			const staffCost = num('staff-cost');
			const cancelReduction = pct('cancel-reduction');
			const timeReduction = pct('time-reduction');

			// Early cancellations: no intermediate rounding, so the cards add up exactly.
			const cancelsWithout = count * cancelRate;
			const cancelsWith = cancelsWithout * (1 - cancelReduction);
			const lostWithout = cancelsWithout * netCostY1;
			const lostWith = cancelsWith * netCostY1;
			const cancelSavings = lostWithout - lostWith;

			// Trainer time: share of the BIBB training staff cost per apprentice.
			const staffWithout = count * staffCost;
			const staffWith = staffWithout * (1 - timeReduction);
			const trainerSavings = staffWithout - staffWith;

			const totalSavings = cancelSavings + trainerSavings;

			// Upper range: same inputs, trainer time reduced by 50% (top of observed range).
			const upperTotal = cancelSavings + staffWithout * 0.5;
			const upperLine = document.getElementById('upper-range-line');
			if (upperLine) upperLine.hidden = timeReduction >= 0.5;

			const set = (id: string, val: string) => { const e = document.getElementById(id); if (e) e.textContent = val; };
			if (countDisplay) countDisplay.textContent = count.toString();
			if (resultCount) resultCount.textContent = count.toString();

			set('total-savings', fmt(totalSavings));
			set('upper-savings', fmt(upperTotal));
			set('cancel-savings', fmt(cancelSavings));
			set('trainer-savings', fmt(trainerSavings));
			set('lost-today', fmt(lostWithout));
			set('cancels-without', one.format(cancelsWithout));
			set('cancels-with', one.format(cancelsWith));
			set('lost-without', fmt(lostWithout));
			set('lost-with', fmt(lostWith));
			set('staff-without', fmt(staffWithout));
			set('staff-with', fmt(staffWith));
		}

		slider.addEventListener('input', calculate);
		document.querySelectorAll<HTMLButtonElement>('.calc-preset').forEach(btn => btn.addEventListener('click', () => {
			const field = document.getElementById('time-reduction') as HTMLInputElement | null;
			if (field) { field.value = btn.dataset.timePreset || '30'; calculate(); }
		}));
		inputs.forEach(input => input.addEventListener('input', calculate));

		calculate();
	}

	document.addEventListener('DOMContentLoaded', initCalculator);
	document.addEventListener('astro:page-load', initCalculator);
</script>

<style>
	.calc-slider::-webkit-slider-thumb {
		-webkit-appearance: none;
		appearance: none;
		width: 20px;
		height: 20px;
		border-radius: 50%;
		background: #7c5cfc;
		cursor: pointer;
		border: 2px solid #27272a;
		box-shadow: 0 0 0 3px rgba(124, 92, 252, 0.2);
	}

	.calc-slider::-moz-range-thumb {
		width: 20px;
		height: 20px;
		border-radius: 50%;
		background: #7c5cfc;
		cursor: pointer;
		border: 2px solid #27272a;
		box-shadow: 0 0 0 3px rgba(124, 92, 252, 0.2);
	}

	@keyframes fadeIn {
		from { opacity: 0; transform: translateY(-4px); }
		to { opacity: 1; transform: translateY(0); }
	}

	.animate-fadeIn {
		animation: fadeIn 0.2s ease-out;
	}
</style>

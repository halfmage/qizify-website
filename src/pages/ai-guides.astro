---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import enContent from '../content/en.json';

const lang = 'en';
const currentPath = '/ai-guides';

// Unguessable paths. The form is a soft gate, so the filenames are not guessable and
// /guides/ is disallowed in robots.txt. See docs/product/ai-guide-conversion-design.md.
const GUIDES = {
	pm: {
		file: '/guides/ai-for-product-managers-2ed946c94f23f52d.pdf',
		title: 'AI for product managers',
		pages: '24 pages',
	},
	po: {
		file: '/guides/ai-for-product-owners-cf79368567bb6cdc.pdf',
		title: 'AI for product owners',
		pages: '20 pages',
	},
};

// Ungated, indexable SEO body and FAQ. The PDFs behind the form are noindex, so this
// section is the only thing on the page a search engine can match to a query. Every
// figure repeats one already sourced inside the guides.
const faq = [
	{
		q: 'Can Microsoft Copilot see your Jira tickets?',
		a: 'If your backlog lives in Jira or Azure DevOps, no tier of Copilot reads it automatically. Microsoft publishes connectors for Jira and Confluence, but an administrator has to deploy them and they enforce the source system\'s own permissions. A connected source is not the same as a readable project.',
	},
	{
		q: 'What is the difference between Copilot Chat and Microsoft 365 Copilot?',
		a: 'Copilot Chat on the basic tier reaches web data only. It sees your work if you paste it, upload it, or have it open in Teams or Outlook. Microsoft 365 Copilot additionally works inside Word, Excel, PowerPoint and OneNote. Only the paid Premium add-on reaches your own files and mail by itself, through Microsoft Graph, and only for files you already have permission to open.',
	},
	{
		q: 'Why does Copilot give a different answer to the same prompt?',
		a: 'Microsoft states in its own guidance that using the same prompt several times can return different responses. That is how the technology works, not a fault. The consequence people miss is that one good answer does not prove the prompt was good. Keep a prompt only once it has produced a usable answer more than once, on different inputs.',
	},
	{
		q: 'What should a product manager never paste into an AI tool?',
		a: 'Three questions settle it in a second. Which account am I signed into, work or personal? Would I put this in an email to a supplier? Is it someone else\'s personal data, such as customer names, recordings, or support tickets with identities in them? Your own company policy overrides all three.',
	},
	{
		q: 'Are the guides free, and do you email the file?',
		a: 'They are free and the download opens straight away. We do not email the file to you. The form asks one question about which kind of help would actually be useful, and your answer decides nothing about the download.',
	},
];

const faqPageSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faq.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const INPUT =
	'bg-input-bg border border-border-light rounded-lg px-4 py-2.5 text-sm text-white font-sans w-full focus:outline-none focus:border-primary transition-colors duration-200';
---

<BaseLayout
	title="AI Guides for Product Managers &amp; Product Owners | LearnSlice"
	description="97% of product managers say AI made them faster. Only 64% say it made their product better. Two free guides on closing that gap, every figure sourced."
	lang={lang}
	currentPath={currentPath}
	breadcrumbTitle="AI guides"
>
	<Header logo={enContent.nav.logo} menu={enContent.nav.menu} cta={enContent.nav.cta} currentLang={lang} currentPath={currentPath} />

	<section class="pt-32 pb-16 px-6 md:px-8">
		<div class="max-w-3xl mx-auto">
			<span class="section-label mb-5 block">Free guide</span>
			<h1 class="text-display-sm md:text-display text-white mb-6">
				97% of product managers say AI made them faster.<br />Only 64% say it made their product better.
			</h1>
			<p class="text-lg text-muted leading-relaxed mb-8">
				Two guides on closing that gap, one for product managers and one for product owners.
				Every number was traced back to the organisation that published it: Product Focus,
				the Scrum Guide, Microsoft's own documentation. Nothing is estimated, and there is
				no sales pitch anywhere in either guide.
			</p>

			<p class="text-sm text-muted leading-relaxed mb-10">
				Written by <strong class="text-white font-medium">Alesia Kunz</strong>, CEO of
				LearnSlice, after 17+ years as a product manager and product owner. The field notes
				throughout are hers.
			</p>

			<ul class="list-none p-0 m-0 mb-12 grid sm:grid-cols-2 gap-x-8 gap-y-3 text-sm text-muted">
				<li class="flex gap-3"><span class="text-accent">01</span> Which Copilot tier can actually see your work, and why most people have the wrong one</li>
				<li class="flex gap-3"><span class="text-accent">02</span> Where AI genuinely helps in a product week, and where it cannot</li>
				<li class="flex gap-3"><span class="text-accent">03</span> Prompts you can paste today, with the four parts that make them work</li>
				<li class="flex gap-3"><span class="text-accent">04</span> A thirty minute weekly routine that needs no budget and nobody's approval</li>
			</ul>

			<!-- Netlify form detection stub. The visible form below posts via fetch. -->
			<form name="ai-guide-download" method="POST" data-netlify="true" netlify-honeypot="bot-field" class="hidden">
				<input type="text" name="bot-field" />
				<input type="email" name="email" />
				<input type="text" name="role" />
				<input type="text" name="country" />
				<input type="text" name="interest" />
				<input type="text" name="weekly" />
				<input type="text" name="privacy-notice-read" />
				<input type="text" name="guide" />
			</form>

			<div id="g-gate" class="bg-surface border border-border rounded-xl p-6 md:p-8">
				<h2 class="text-heading-sm text-white m-0 mb-2">Get the guide</h2>
				<p class="text-sm text-muted m-0 mb-6">
					The download opens straight away. We do not email you the file.
				</p>

				<form class="flex flex-col gap-5" id="g-form" method="POST" data-netlify="true" netlify-honeypot="bot-field">
					<input type="hidden" name="form-name" value="ai-guide-download" />
					<input type="text" name="bot-field" class="hidden" tabindex="-1" aria-hidden="true" />

					<div class="grid sm:grid-cols-2 gap-4">
						<div class="flex flex-col gap-1.5">
							<label for="g-email" class="text-sm font-medium text-white/80">Work email</label>
							<input type="email" id="g-email" name="email" required aria-required="true" autocomplete="email" class={INPUT} />
						</div>
						<div class="flex flex-col gap-1.5">
							<label for="g-country" class="text-sm font-medium text-white/80">Country</label>
							<select id="g-country" name="country" required aria-required="true" class={INPUT}>
								<option value="">Please choose</option>
								<option>Germany</option>
								<option>Austria</option>
								<option>Switzerland</option>
								<option>United Kingdom</option>
								<option>Netherlands</option>
								<option>France</option>
								<option>Spain</option>
								<option>Italy</option>
								<option>Poland</option>
								<option>Nordics</option>
								<option>United States</option>
								<option>Canada</option>
								<option>Australia or New Zealand</option>
								<option>Elsewhere in Europe</option>
								<option>Elsewhere</option>
							</select>
						</div>
					</div>

					<fieldset class="border-0 p-0 m-0">
						<legend class="text-sm font-medium text-white/80 mb-2 p-0">Your role</legend>
						<div class="grid sm:grid-cols-2 gap-2">
							<label class="flex items-center gap-2.5 text-sm text-muted cursor-pointer bg-input-bg border border-border-light rounded-lg px-4 py-2.5">
								<input type="radio" name="role" value="Product manager" required class="accent-primary" /> Product manager
							</label>
							<label class="flex items-center gap-2.5 text-sm text-muted cursor-pointer bg-input-bg border border-border-light rounded-lg px-4 py-2.5">
								<input type="radio" name="role" value="Product owner" class="accent-primary" /> Product owner
							</label>
							<label class="flex items-center gap-2.5 text-sm text-muted cursor-pointer bg-input-bg border border-border-light rounded-lg px-4 py-2.5">
								<input type="radio" name="role" value="Head of product" class="accent-primary" /> Head of product, director or VP
							</label>
							<label class="flex items-center gap-2.5 text-sm text-muted cursor-pointer bg-input-bg border border-border-light rounded-lg px-4 py-2.5">
								<input type="radio" name="role" value="Other" class="accent-primary" /> Something else
							</label>
						</div>
					</fieldset>

					<fieldset class="border-0 p-0 m-0">
						<legend class="text-sm font-medium text-white/80 mb-1 p-0">Which of these would actually help you?</legend>
						<p class="text-xs text-gray m-0 mb-2">This is the only thing we ask for in return. It decides nothing about your download.</p>
						<div class="flex flex-col gap-2">
							<label class="flex items-start gap-2.5 text-sm text-muted cursor-pointer bg-input-bg border border-border-light rounded-lg px-4 py-2.5">
								<input type="radio" name="interest" value="A question about my own work" required class="accent-primary mt-0.5" />
								<span>I have a question about applying this to my own work</span>
							</label>
							<label class="flex items-start gap-2.5 text-sm text-muted cursor-pointer bg-input-bg border border-border-light rounded-lg px-4 py-2.5">
								<input type="radio" name="interest" value="AI academy for my team" class="accent-primary mt-0.5" />
								<span>I would like to apply to the AI academy when it opens</span>
							</label>
							<label class="flex items-start gap-2.5 text-sm text-muted cursor-pointer bg-input-bg border border-border-light rounded-lg px-4 py-2.5">
								<input type="radio" name="interest" value="Build our own academy" class="accent-primary mt-0.5" />
								<span>We would like to build our own academy, on our content and our brand</span>
							</label>
							<label class="flex items-start gap-2.5 text-sm text-muted cursor-pointer bg-input-bg border border-border-light rounded-lg px-4 py-2.5">
								<input type="radio" name="interest" value="Custom software on our own data" class="accent-primary mt-0.5" />
								<span>We need software that works on our own data, because our tools cannot see it</span>
							</label>
							<label class="flex items-start gap-2.5 text-sm text-muted cursor-pointer bg-input-bg border border-border-light rounded-lg px-4 py-2.5">
								<input type="radio" name="interest" value="Just the guide" class="accent-primary mt-0.5" />
								<span>None of these for now, I just want the guide</span>
							</label>
						</div>
					</fieldset>

					<label class="flex items-start gap-2.5 text-sm text-muted cursor-pointer">
						<input type="checkbox" id="g-weekly" name="weekly" value="yes" class="accent-primary mt-0.5" />
						<span>Send me the weekly. One change that matters, one prompt, one thing worth reading, and one line on what we got wrong the week before. Five minutes, unsubscribe whenever.</span>
					</label>

					<label class="flex items-start gap-2.5 text-sm text-muted cursor-pointer">
						<input type="checkbox" id="g-consent" name="privacy-notice-read" value="yes" required aria-required="true" class="accent-primary mt-0.5" />
						<span>I have read the <a href="/privacy" class="text-accent underline">privacy policy</a> and understand how LearnSlice uses the details above.</span>
					</label>

					<p id="g-error" class="hidden text-sm text-crit m-0" role="alert"></p>

					<button type="submit" id="g-submit" disabled
						class="bg-primary text-white rounded-lg px-6 py-3 text-sm font-medium disabled:opacity-40 disabled:cursor-not-allowed transition-opacity duration-200">
						Get my guide, free
					</button>
				</form>
			</div>

			<div id="g-result" tabindex="-1" class="hidden bg-surface border border-border rounded-xl p-6 md:p-8">
				<h2 class="text-heading-sm text-white m-0 mb-2">Here it is</h2>
				<p class="text-sm text-muted m-0 mb-6" id="g-result-note"></p>
				<a id="g-download" href="#" download
					class="inline-block bg-primary text-white rounded-lg px-6 py-3 text-sm font-medium no-underline">
					Download the PDF
				</a>
				<p class="text-xs text-gray mt-6 mb-0">
					Keep the link. It does not expire, and forwarding it to a colleague is fine by us.
				</p>
			</div>
		</div>
	</section>



	<section class="pb-24 px-6 md:px-8">
		<div class="max-w-3xl mx-auto">
			<h2 class="text-heading-sm md:text-heading text-white mt-0 mb-4">
				AI for product managers: discovery, prioritisation, updates
			</h2>
			<p class="text-base text-muted leading-relaxed m-0">
				AI does two things in a product week. It changes how fast you produce work, and it
				changes what you decide. Only the second moves the product, which is why 97% of
				product managers report better personal productivity and only 64% report better
				product outcomes. Sharpening the questions before a customer interview beats
				drafting faster. The guide covers five places the week goes wrong, and names what
				the tool cannot do in each.
			</p>

			<h2 class="text-heading-sm md:text-heading text-white mt-10 mb-4">
				AI for product owners: refinement, ordering, sprint goals
			</h2>
			<p class="text-base text-muted leading-relaxed m-0">
				The product owner guide follows the five accountabilities the Scrum Guide names as
				yours: writing items, refining them, ordering them, proposing the value of a
				sprint, and showing what changed. AI backlog refinement works on the parts you
				should have settled before the session. It will list the questions a developer
				would ask before picking an item up, and draft acceptance criteria that are
				testable rather than a restatement of the title. It cannot order your backlog and
				it cannot decide what is valuable. That judgment is the job, and writing a good
				user story stays teamwork.
			</p>

			<h2 class="text-heading-sm md:text-heading text-white mt-10 mb-4">
				Why Copilot cannot see your backlog
			</h2>
			<p class="text-base text-muted leading-relaxed m-0">
				Two sources feed any answer: the public web, and your organisation's own content.
				Only the premium tier reaches the second by itself. If your backlog lives in Jira
				or Azure DevOps, no tier reads it automatically. Most people who think Copilot is
				useless are on a licence that cannot read their work, which is a licensing fact
				rather than a skill problem. Both guides give the tier table.
			</p>

			<h2 class="text-heading-sm md:text-heading text-white mt-10 mb-4">
				AI prompts for product managers and product owners
			</h2>
			<p class="text-base text-muted leading-relaxed m-0">
				Microsoft's own prompt framework has four parts: goal, context, expectations and
				source. Both prompt packs are written that way and are copyable as they stand,
				with the parts you change marked. No prompt returns finished work. Each returns
				something you still have to decide on, which is the point.
			</p>

			<h2 class="text-heading-sm md:text-heading text-white mt-12 mb-4">Learn it here, then apply it</h2>
			<p class="text-base text-muted leading-relaxed m-0 mb-4">
				LearnSlice is a learning company that builds with AI. Teaching people to use these
				tools well is the work here rather than a wrapper around it, which is why the
				guides are free and complete and there is nothing to buy in order to use them.
				They are written by Alesia Kunz, our CEO, after 17+ years as a product manager and
				product owner.
			</p>
			<p class="text-base text-muted leading-relaxed m-0 mb-4">
				They are built to be applied, not read. Every chapter ends with a first step you
				can take this week, and Part 4 is a thirty minute weekly routine that costs
				nothing and needs nobody's approval. Do it on your own real work, which is the
				only way to tell whether the output is any good.
			</p>
			<p class="text-base text-muted leading-relaxed m-0 mb-4">
				If you want to go further, four routes exist and each one starts with you. Send a
				question to <a href="mailto:info@learnslice.com" class="text-accent no-underline">info@learnslice.com</a>
				and Alesia answers it. Apply to the AI academy, which runs this across a team with
				content matched to your sector and a record of who learned what. Ask us to build
				your own academy, on your content and your brand. Or bring an AI engineering
				project, if the real problem is that your tools cannot read your tickets and
				documents.
			</p>
			<p class="text-sm text-gray m-0 mb-2">
				Downloading starts no sales sequence, and nothing is emailed to you that you did not
				ask for. If you want a conversation, you start it.
			</p>

			<h2 class="text-heading-sm md:text-heading text-white mt-12 mb-6">Common questions</h2>
			<div class="flex flex-col gap-3">
				{faq.map((item) => (
					<details class="group bg-surface border border-border rounded-xl px-5 py-4">
						<summary class="flex items-center justify-between gap-4 cursor-pointer text-base font-medium text-white list-none marker:hidden [&::-webkit-details-marker]:hidden">
							{item.q}
							<span class="text-gray transition-transform duration-200 group-open:rotate-45">+</span>
						</summary>
						<p class="text-sm text-muted leading-relaxed mt-3 mb-0">{item.a}</p>
					</details>
				))}
			</div>
		</div>
	</section>

	<script type="application/ld+json" set:html={JSON.stringify(faqPageSchema)} />

	<Footer currentLang={lang} privacyLabel={enContent.footer.privacyLabel} termsLabel={enContent.footer.termsLabel} />
</BaseLayout>

<script is:inline define:vars={{ GUIDES }}>
	(function () {
		const form = document.getElementById('g-form');
		if (!form) return;
		const gate = document.getElementById('g-gate');
		const result = document.getElementById('g-result');
		const note = document.getElementById('g-result-note');
		const link = document.getElementById('g-download');
		const submitBtn = document.getElementById('g-submit');
		const consent = document.getElementById('g-consent');
		const error = document.getElementById('g-error');

		// Submit stays muted until consent is ticked, matching the readiness check.
		const sync = () => { submitBtn.disabled = !consent.checked; };
		consent.addEventListener('change', sync);
		sync();

		// Product owners get the PO guide. Everyone else gets the PM guide, which
		// carries the section for people who lead a team.
		const pick = () => {
			const role = (new FormData(form)).get('role');
			return role === 'Product owner' ? GUIDES.po : GUIDES.pm;
		};

		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			if (submitBtn.disabled) return;
			submitBtn.disabled = true;
			submitBtn.textContent = 'One moment…';
			error.classList.add('hidden');

			const guide = pick();
			const data = new FormData(form);
			data.set('guide', guide.title);
			// An unticked checkbox is simply absent, which makes "declined" and
			// "field missing" indistinguishable in the export.
			data.set('weekly', document.getElementById('g-weekly').checked ? 'yes' : 'no');

			// Netlify only captures on the deployed site; skip the call locally so the
			// whole flow stays previewable.
			const isLocal = ['localhost', '127.0.0.1'].includes(location.hostname);
			try {
				if (!isLocal) {
					const res = await fetch('/', {
						method: 'POST',
						headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
						body: new URLSearchParams(data).toString(),
					});
					if (!res.ok) throw new Error('submission failed');
				}
				link.href = guide.file;
				note.textContent = guide.title + ', ' + guide.pages + '. The twenty-minute path starts on page three.';
				gate.classList.add('hidden');
				result.classList.remove('hidden');
				result.focus({ preventScroll: true });
				result.scrollIntoView({ behavior: 'smooth', block: 'start' });
			} catch (err) {
				submitBtn.disabled = !consent.checked;
				submitBtn.textContent = 'Get my guide, free';
				error.textContent = 'Something went wrong. Please try again, or write to us directly.';
				error.classList.remove('hidden');
			}
		});
	})();
</script>

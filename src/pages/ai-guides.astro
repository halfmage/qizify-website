---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import enContent from '../content/en.json';

const lang = 'en';
const currentPath = '/ai-guides';

// Unguessable paths. The form is a soft gate, so the filenames are not guessable and
// /guides/ is disallowed in robots.txt. See docs/product/ai-guide-conversion-design.md.
const GUIDES = {
	pm: {
		file: '/guides/ai-for-product-managers-2ed946c94f23f52d.pdf',
		title: 'AI for product managers',
		pages: '23 pages',
	},
	po: {
		file: '/guides/ai-for-product-owners-cf79368567bb6cdc.pdf',
		title: 'AI for product owners',
		pages: '19 pages',
	},
};

const INPUT =
	'bg-input-bg border border-border-light rounded-lg px-4 py-2.5 text-sm text-white font-sans w-full focus:outline-none focus:border-primary transition-colors duration-200';
---

<BaseLayout
	title="AI guides for product managers and product owners | LearnSlice"
	description="Two practical guides on using AI in product work, benchmarked against published research. What the tools can do, what they cannot, and the prompts worth keeping."
	lang={lang}
	currentPath={currentPath}
	breadcrumbTitle="AI guides"
>
	<Header logo={enContent.nav.logo} menu={enContent.nav.menu} cta={enContent.nav.cta} currentLang={lang} currentPath={currentPath} />

	<section class="pt-32 pb-16 px-6 md:px-8">
		<div class="max-w-3xl mx-auto">
			<span class="section-label mb-5 block">Free guide</span>
			<h1 class="text-display-sm md:text-display text-white mb-6">
				97% of product managers say AI made them faster.<br />Only 64% say it made their product better.
			</h1>
			<p class="text-lg text-muted leading-relaxed mb-8">
				Two guides on closing that gap, one for product managers and one for product owners.
				Every figure is traced to the body that published it. Nothing is estimated, and nothing
				before the last page is an advertisement.
			</p>

			<ul class="list-none p-0 m-0 mb-12 grid sm:grid-cols-2 gap-x-8 gap-y-3 text-sm text-muted">
				<li class="flex gap-3"><span class="text-accent">01</span> Which Copilot tier can actually see your work, and why most people have the wrong one</li>
				<li class="flex gap-3"><span class="text-accent">02</span> Where AI genuinely helps in a product week, and where it cannot</li>
				<li class="flex gap-3"><span class="text-accent">03</span> Prompts you can paste today, with the four parts that make them work</li>
				<li class="flex gap-3"><span class="text-accent">04</span> A thirty minute weekly routine that needs no budget and nobody's approval</li>
			</ul>

			<!-- Netlify form detection stub. The visible form below posts via fetch. -->
			<form name="ai-guide-download" method="POST" data-netlify="true" netlify-honeypot="bot-field" class="hidden">
				<input type="text" name="bot-field" />
				<input type="email" name="email" />
				<input type="text" name="role" />
				<input type="text" name="country" />
				<input type="text" name="interest" />
				<input type="text" name="weekly" />
				<input type="text" name="consent" />
				<input type="text" name="guide" />
			</form>

			<div id="g-gate" class="bg-surface border border-border rounded-xl p-6 md:p-8">
				<h2 class="text-heading-sm text-white m-0 mb-2">Get the guide</h2>
				<p class="text-sm text-muted m-0 mb-6">
					The download opens straight away. We do not email you the file.
				</p>

				<form class="flex flex-col gap-5" id="g-form" method="POST" data-netlify="true" netlify-honeypot="bot-field">
					<input type="hidden" name="form-name" value="ai-guide-download" />
					<input type="text" name="bot-field" class="hidden" tabindex="-1" aria-hidden="true" />

					<div class="grid sm:grid-cols-2 gap-4">
						<div class="flex flex-col gap-1.5">
							<label for="g-email" class="text-sm font-medium text-white/80">Work email</label>
							<input type="email" id="g-email" name="email" required aria-required="true" autocomplete="email" class={INPUT} />
						</div>
						<div class="flex flex-col gap-1.5">
							<label for="g-country" class="text-sm font-medium text-white/80">Country</label>
							<select id="g-country" name="country" required aria-required="true" class={INPUT}>
								<option value="">Please choose</option>
								<option>Germany</option>
								<option>Austria</option>
								<option>Switzerland</option>
								<option>United Kingdom</option>
								<option>Netherlands</option>
								<option>France</option>
								<option>Spain</option>
								<option>Italy</option>
								<option>Poland</option>
								<option>Nordics</option>
								<option>United States</option>
								<option>Canada</option>
								<option>Australia or New Zealand</option>
								<option>Elsewhere in Europe</option>
								<option>Elsewhere</option>
							</select>
						</div>
					</div>

					<fieldset class="border-0 p-0 m-0">
						<legend class="text-sm font-medium text-white/80 mb-2 p-0">Your role</legend>
						<div class="grid sm:grid-cols-2 gap-2">
							<label class="flex items-center gap-2.5 text-sm text-muted cursor-pointer bg-input-bg border border-border-light rounded-lg px-4 py-2.5">
								<input type="radio" name="role" value="Product manager" required class="accent-primary" /> Product manager
							</label>
							<label class="flex items-center gap-2.5 text-sm text-muted cursor-pointer bg-input-bg border border-border-light rounded-lg px-4 py-2.5">
								<input type="radio" name="role" value="Product owner" class="accent-primary" /> Product owner
							</label>
							<label class="flex items-center gap-2.5 text-sm text-muted cursor-pointer bg-input-bg border border-border-light rounded-lg px-4 py-2.5">
								<input type="radio" name="role" value="Head of product" class="accent-primary" /> Head of product, director or VP
							</label>
							<label class="flex items-center gap-2.5 text-sm text-muted cursor-pointer bg-input-bg border border-border-light rounded-lg px-4 py-2.5">
								<input type="radio" name="role" value="Other" class="accent-primary" /> Something else
							</label>
						</div>
					</fieldset>

					<fieldset class="border-0 p-0 m-0">
						<legend class="text-sm font-medium text-white/80 mb-1 p-0">Which of these would actually help you?</legend>
						<p class="text-xs text-gray m-0 mb-2">This is the only thing we ask for in return.</p>
						<div class="flex flex-col gap-2">
							<label class="flex items-start gap-2.5 text-sm text-muted cursor-pointer bg-input-bg border border-border-light rounded-lg px-4 py-2.5">
								<input type="radio" name="interest" value="AI academy for my team" required class="accent-primary mt-0.5" />
								<span>An AI academy for my team, with our own content and a record of who learned what</span>
							</label>
							<label class="flex items-start gap-2.5 text-sm text-muted cursor-pointer bg-input-bg border border-border-light rounded-lg px-4 py-2.5">
								<input type="radio" name="interest" value="Custom software on our own data" class="accent-primary mt-0.5" />
								<span>Software that works on our own data, because the tools we have cannot see it</span>
							</label>
							<label class="flex items-start gap-2.5 text-sm text-muted cursor-pointer bg-input-bg border border-border-light rounded-lg px-4 py-2.5">
								<input type="radio" name="interest" value="Just the guide" class="accent-primary mt-0.5" />
								<span>Neither for now, I just want the guide</span>
							</label>
						</div>
					</fieldset>

					<label class="flex items-start gap-2.5 text-sm text-muted cursor-pointer">
						<input type="checkbox" id="g-weekly" name="weekly" value="yes" class="accent-primary mt-0.5" />
						<span>Send me the weekly update: one change that matters, one prompt, one thing worth reading. Five minutes, unsubscribe whenever.</span>
					</label>

					<label class="flex items-start gap-2.5 text-sm text-muted cursor-pointer">
						<input type="checkbox" id="g-consent" name="consent" value="yes" required aria-required="true" class="accent-primary mt-0.5" />
						<span>I agree that LearnSlice may store the details above to provide this guide, as set out in the <a href="/privacy" class="text-accent underline">privacy policy</a>.</span>
					</label>

					<p id="g-error" class="hidden text-sm text-crit m-0" role="alert"></p>

					<button type="submit" id="g-submit" disabled
						class="bg-primary text-white rounded-lg px-6 py-3 text-sm font-medium disabled:opacity-40 disabled:cursor-not-allowed transition-opacity duration-200">
						Show me the guide
					</button>
				</form>
			</div>

			<div id="g-result" tabindex="-1" class="hidden bg-surface border border-border rounded-xl p-6 md:p-8">
				<h2 class="text-heading-sm text-white m-0 mb-2">Here it is</h2>
				<p class="text-sm text-muted m-0 mb-6" id="g-result-note"></p>
				<a id="g-download" href="#" download
					class="inline-block bg-primary text-white rounded-lg px-6 py-3 text-sm font-medium no-underline">
					Download the PDF
				</a>
				<p class="text-xs text-gray mt-6 mb-0">
					Keep the link. It does not expire, and forwarding it to a colleague is fine by us.
				</p>
			</div>
		</div>
	</section>

	<Footer currentLang={lang} privacyLabel={enContent.footer.privacyLabel} termsLabel={enContent.footer.termsLabel} />
</BaseLayout>

<script is:inline define:vars={{ GUIDES }}>
	(function () {
		const form = document.getElementById('g-form');
		if (!form) return;
		const gate = document.getElementById('g-gate');
		const result = document.getElementById('g-result');
		const note = document.getElementById('g-result-note');
		const link = document.getElementById('g-download');
		const submitBtn = document.getElementById('g-submit');
		const consent = document.getElementById('g-consent');
		const error = document.getElementById('g-error');

		// Submit stays muted until consent is ticked, matching the readiness check.
		const sync = () => { submitBtn.disabled = !consent.checked; };
		consent.addEventListener('change', sync);
		sync();

		// Product owners get the PO guide. Everyone else gets the PM guide, which
		// carries the section for people who lead a team.
		const pick = () => {
			const role = (new FormData(form)).get('role');
			return role === 'Product owner' ? GUIDES.po : GUIDES.pm;
		};

		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			if (submitBtn.disabled) return;
			submitBtn.disabled = true;
			submitBtn.textContent = 'One moment…';
			error.classList.add('hidden');

			const guide = pick();
			const data = new FormData(form);
			data.set('guide', guide.title);
			// An unticked checkbox is simply absent, which makes "declined" and
			// "field missing" indistinguishable in the export.
			data.set('weekly', document.getElementById('g-weekly').checked ? 'yes' : 'no');

			// Netlify only captures on the deployed site; skip the call locally so the
			// whole flow stays previewable.
			const isLocal = ['localhost', '127.0.0.1'].includes(location.hostname);
			try {
				if (!isLocal) {
					const res = await fetch('/', {
						method: 'POST',
						headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
						body: new URLSearchParams(data).toString(),
					});
					if (!res.ok) throw new Error('submission failed');
				}
				link.href = guide.file;
				note.textContent = guide.title + ', ' + guide.pages + ', PDF.';
				gate.classList.add('hidden');
				result.classList.remove('hidden');
				result.focus({ preventScroll: true });
				result.scrollIntoView({ behavior: 'smooth', block: 'start' });
			} catch (err) {
				submitBtn.disabled = !consent.checked;
				submitBtn.textContent = 'Show me the guide';
				error.textContent = 'Something went wrong. Please try again, or write to us directly.';
				error.classList.remove('hidden');
			}
		});
	})();
</script>

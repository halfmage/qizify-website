---
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import BlogCard from '../components/BlogCard.astro';
import CTAFooter from '../components/CTAFooter.astro';
import Footer from '../components/Footer.astro';
import DemoRequestModal from '../components/DemoRequestModal.astro';
import ConsultationModal from '../components/ConsultationModal.astro';
import enContent from '../content/en.json';
import deContent from '../content/de.json';
import { isTeamAuthor } from '../utils/authors.mjs';
import { SIGNUP_ID, FREE_AUSBILDER_LIMIT, FREE_AZUBI_LIMIT, signupUrl } from '../data/berichtsheft.mjs';

interface Props {
	title: string;
	description: string;
	lang: 'en' | 'de';
	publishDate: Date;
	updatedDate?: Date;
	author: string;
	authorRole?: string;
	tags: string[];
	slug: string;
	ogImage?: string;
	keyTakeaways?: string[];
	faq?: { q: string; a: string }[];
	sources?: { name: string; url: string; retrieved?: string }[];
	about?: string[];
	ctaVariant?: 'demo' | 'consultation' | 'guide' | 'berichtsheft';
	ctaFooter?: { label?: string; headline: string; subheadline: string; button: string };
	heroImage?: string;
}

const { title, description, lang, publishDate, updatedDate, author, authorRole, tags, slug, ogImage, keyTakeaways, faq, sources, about, ctaVariant = 'demo', ctaFooter, heroImage } = Astro.props;

// Byline role. Defaults to the content-team title the existing named posts were
// written under, so those are unchanged; anyone else sets authorRole explicitly.
const bylineRole = authorRole ?? 'Junior Content Manager';

const content = lang === 'en' ? enContent : deContent;
const basePath = lang === 'de' ? '/de' : '';
const currentPath = `${basePath}/blog/${slug}`;
const blogIndexPath = `${basePath}/blog`;
const backLabel = lang === 'en' ? 'Back to Blog' : 'Zur\u00FCck zum Blog';

const formattedDate = publishDate.toLocaleDateString(lang === 'en' ? 'en-US' : 'de-DE', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
});

const formattedUpdatedDate = updatedDate?.toLocaleDateString(lang === 'en' ? 'en-US' : 'de-DE', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
});

const blogOgImage = ogImage || '/opengraph-image.jpg';

const allPosts = await getCollection('blog');
const ownTags = new Set(tags);

const scoredPosts = allPosts
	.filter(p => p.data.lang === lang && p.slug !== slug)
	.map(p => ({
		post: p,
		score: p.data.tags.filter(t => ownTags.has(t)).length,
		date: new Date(p.data.publishDate).getTime(),
	}))
	.sort((a, b) => b.score - a.score || b.date - a.date);

const relatedPosts = scoredPosts.slice(0, 3).map(s => s.post);

const relatedHeading = lang === 'en' ? 'More on this topic' : 'Mehr zum Thema';
const takeawaysHeading = lang === 'en' ? 'Key Takeaways' : 'Auf einen Blick';
const faqHeading = lang === 'en' ? 'Frequently Asked Questions' : 'Häufig gestellte Fragen';
const tocLabel = lang === 'en' ? 'On this page' : 'Auf dieser Seite';
// Conversion path is chosen per post via `ctaVariant`. Solutions/custom-dev posts
// use the strategy-call consultation flow; 'guide' posts send the reader to the
// AI guides (now on ironum.com) and open no modal at all; everything else keeps the demo.
const isConsultation = ctaVariant === 'consultation';
const isGuide = ctaVariant === 'guide';
// 'berichtsheft' posts embed BerichtsheftSignup (free Berichtsheft, live since
// 2026-11-10). The nav CTA jumps to that block, which states the free-plan limits;
// sidebar and footer go straight to the app sign-up, tagged with the post slug.
const isBerichtsheft = ctaVariant === 'berichtsheft';
const SIGNUP_ANCHOR = `#${SIGNUP_ID[lang]}`;
// The AI guides moved to Ironum (Oct 2026); no LearnSlice post uses this variant today.
const GUIDE_HREF = 'https://ironum.com/resources/guides/';
const ctaTrigger = isConsultation ? 'project-inquiry' : 'demo-request';
// A guide post's CTAs are links, so nothing should carry a modal trigger.
const ctaHref = isGuide ? GUIDE_HREF : isBerichtsheft ? SIGNUP_ANCHOR : undefined;
const navCta = isBerichtsheft
	? (lang === 'en' ? 'Start for free' : 'Kostenlos starten')
	: isGuide
	? (lang === 'en' ? 'Get the guides' : 'Leitfäden holen')
	: isConsultation
	? content.solutions.hero.ctaPrimary
	: content.nav.cta;

const sidebarCopy = isBerichtsheft
	? {
		title: lang === 'en' ? 'Free training logbook' : 'Berichtsheft kostenlos',
		sub: lang === 'en'
			? `For ${FREE_AUSBILDER_LIMIT} trainer and up to ${FREE_AZUBI_LIMIT} apprentices. No payment details.`
			: `Für ${FREE_AUSBILDER_LIMIT} Ausbilder und bis zu ${FREE_AZUBI_LIMIT} Azubis. Ohne Zahlungsdaten.`,
		button: lang === 'en' ? 'Start for free' : 'Kostenlos starten',
	}
	: isGuide
	? {
		title: lang === 'en' ? 'The longer version is free' : 'Die ausführliche Fassung, kostenlos',
		sub: lang === 'en' ? 'Guides for product managers and product owners. No email required.' : 'Leitfäden für Product Manager und Product Owner. Ohne E-Mail-Versand.',
		button: lang === 'en' ? 'Get the guides' : 'Leitfäden holen',
	}
	: isConsultation
	? {
		title: lang === 'en' ? 'Quote or strategy call' : 'Angebot oder Gespräch',
		sub: lang === 'en' ? 'A quote or a 30-min call, no pitch.' : 'Kostenschätzung oder 30-Min-Gespräch, kein Pitch.',
		button: lang === 'en' ? 'Get a project quote' : 'Angebot anfragen',
	}
	: ctaFooter
	? {
		// Campaign posts with their own footer promise get a matching sidebar card
		title: ctaFooter.label ?? ctaFooter.headline,
		sub: lang === 'en' ? '30 minutes, no pitch.' : '30 Minuten, kein Pitch.',
		button: ctaFooter.button,
	}
	: {
		title: lang === 'en' ? 'See it on your occupation' : 'An Ihrem Beruf sehen',
		sub: lang === 'en' ? '30-min demo, no pitch.' : '30-Min-Demo, kein Pitch.',
		button: lang === 'en' ? 'Get demo access' : 'Demo-Zugang erhalten',
	};
// Links (guide, berichtsheft) open no modal; everything else opens the variant's modal.
const sidebarCta = {
	...sidebarCopy,
	href: isBerichtsheft ? signupUrl(`${slug}-sidebar`) : ctaHref ?? `#${ctaTrigger}`,
	trigger: ctaHref ? undefined : ctaTrigger,
};

// Footer CTA: guide posts link to the lead magnet; consultation posts reuse the
// solutions strategy-call copy (headline, sub, button, micro-proof note); demo posts
// keep the site-wide blog CTA.
const footerCta = isBerichtsheft
	? {
		label: lang === 'en' ? 'Free plan' : 'Kostenloser Tarif',
		headline: lang === 'en' ? 'The LearnSlice Training Logbook, Free for Training Companies' : 'Das LearnSlice-Berichtsheft, kostenlos für Ausbildungsbetriebe',
		subheadline: lang === 'en'
			? `Apprentices write and submit their entries, trainers approve them or send them back, and every record exports as a PDF. Free for ${FREE_AUSBILDER_LIMIT} trainer and up to ${FREE_AZUBI_LIMIT} apprentices.`
			: `Azubis schreiben und reichen ein, Ausbilder geben frei oder schicken zurück, und jeder Nachweis lässt sich als PDF exportieren. Kostenlos für ${FREE_AUSBILDER_LIMIT} Ausbilder und bis zu ${FREE_AZUBI_LIMIT} Azubis.`,
		button: lang === 'en' ? 'Start for free' : 'Kostenlos starten',
		note: lang === 'en' ? 'No payment details. Upgrade only if you want more.' : 'Ohne Zahlungsdaten. Upgrade nur, wenn Sie mehr wollen.',
		href: signupUrl(`${slug}-footer`),
	}
	: isGuide
	? {
		headline: lang === 'en' ? 'Practical, and ready to apply' : 'Praktisch und sofort anwendbar',
		subheadline: lang === 'en'
			? 'Two free guides for product managers and product owners. Thirty minutes a week is enough to start. The download opens straight away, we do not email you the file, and it starts no sales sequence.'
			: 'Zwei kostenlose Leitfäden für Product Manager und Product Owner. Dreißig Minuten pro Woche genügen für den Anfang. Der Download startet sofort, wir schicken die Datei nicht per E-Mail, und es folgt keine Verkaufssequenz.',
		button: lang === 'en' ? 'Get the guides, free' : 'Leitfäden kostenlos holen',
		note: undefined,
		href: GUIDE_HREF,
	}
	: isConsultation
	? {
		headline: content.solutions.cta.headline,
		subheadline: lang === 'en'
			? 'Request a no-obligation quote or book a free 30-minute strategy call. No pitch, just a concrete roadmap and a ballpark price.'
			: 'Fordern Sie eine unverbindliche Kostenschätzung an oder buchen Sie ein kostenloses 30-Minuten-Strategiegespräch. Kein Pitch, nur eine konkrete Roadmap und ein Preisrahmen.',
		button: lang === 'en' ? 'Get a project quote' : 'Angebot anfragen',
		note: content.solutions.cta.note,
		href: '#project-inquiry',
	}
	: ctaFooter
	? {
		label: ctaFooter.label,
		headline: ctaFooter.headline,
		subheadline: ctaFooter.subheadline,
		button: ctaFooter.button,
		note: undefined,
		href: '#demo-request',
	}
	: {
		headline: content.cta.headline,
		subheadline: content.cta.subheadline,
		button: content.cta.button,
		note: undefined,
		href: '#demo-request',
	};

const faqPageSchema = faq && faq.length > 0 ? {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faq.map(({ q, a }) => ({
		'@type': 'Question',
		name: q,
		acceptedAnswer: {
			'@type': 'Answer',
			text: a,
		},
	})),
} : null;

const blogPostingSchema = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: title,
	description: description,
	image: `https://learnslice.com${blogOgImage}`,
	datePublished: publishDate.toISOString(),
	// Google and Bing read dateModified as the freshness signal; fall back to the publish date.
	dateModified: (updatedDate ?? publishDate).toISOString(),
	inLanguage: lang === 'de' ? 'de-DE' : 'en-US',
	author: isTeamAuthor(author)
		? {
			'@type': 'Organization',
			name: 'LearnSlice',
			url: 'https://learnslice.com',
			sameAs: [
				'https://www.linkedin.com/company/49113282',
				'https://www.instagram.com/learnslice',
			],
		}
		: {
			'@type': 'Person',
			name: author,
			jobTitle: bylineRole,
			worksFor: {
				'@type': 'Organization',
				name: 'LearnSlice',
				url: 'https://learnslice.com',
			},
		},
	publisher: {
		'@type': 'Organization',
		name: 'LearnSlice',
		url: 'https://learnslice.com',
		logo: {
			'@type': 'ImageObject',
			url: 'https://learnslice.com/images/learnslice-logo.svg',
		},
	},
	mainEntityOfPage: {
		'@type': 'WebPage',
		'@id': `https://learnslice.com${currentPath}`,
	},
	...(about && about.length > 0 ? { about: about.map((name) => ({ '@type': 'Thing', name })) } : {}),
	...(sources && sources.length > 0 ? {
		citation: sources.map((s) => ({ '@type': 'CreativeWork', name: s.name, url: s.url })),
	} : {}),
};
const sourcesHeading = lang === 'en' ? 'Sources' : 'Quellen';
const retrievedLabel = lang === 'en' ? 'checked' : 'geprüft am';
// `retrieved` is validated as YYYY-MM-DD in content/config.ts. Parsed as UTC noon so
// the day cannot shift with the build machine's time zone; written out in words in
// English ("2 November 2026"), since 02/11/2026 reads as 11 February to US readers.
const formatRetrieved = (d: string) =>
	new Date(`${d}T12:00:00Z`).toLocaleDateString(lang === 'en' ? 'en-GB' : 'de-DE', {
		year: 'numeric',
		month: lang === 'en' ? 'long' : '2-digit',
		day: lang === 'en' ? 'numeric' : '2-digit',
		timeZone: 'UTC',
	});
---

<BaseLayout
	title={title}
	description={description}
	lang={lang}
	currentPath={currentPath}
	breadcrumbTitle={title}
	ogImage={ogImage}
	heroImage={heroImage}
	softwareSchema={!isGuide}
>
	<Header
		logo={content.nav.logo}
		menu={content.nav.menu}
		cta={navCta}
		ctaModalTrigger={ctaTrigger}
		ctaHref={ctaHref}
		currentLang={lang}
		currentPath={currentPath}
	/>

	<article class="py-20 md:py-28 px-6 md:px-8 pt-32">
		<div class="max-w-2xl lg:max-w-6xl mx-auto lg:grid lg:grid-cols-[minmax(0,46rem)_15rem] lg:justify-center lg:gap-16">
		<div class="min-w-0">
			<!-- Back link -->
			<a
				href={blogIndexPath}
				class="inline-flex items-center gap-2 text-muted hover:text-white transition-colors text-sm mb-10"
			>
				<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
					<line x1="19" y1="12" x2="5" y2="12"></line>
					<polyline points="12 19 5 12 12 5"></polyline>
				</svg>
				{backLabel}
			</a>

			<!-- Article header -->
			<header class="mb-12">
				{tags.length > 0 && (
					<div class="flex flex-wrap gap-2 mb-4">
						{tags.map(tag => (
							<span class="section-label">{tag}</span>
						))}
					</div>
				)}

				<h1 class="text-display-sm md:text-display text-white mb-6">
					{title}
				</h1>

				<div class="flex items-center gap-3 text-muted text-sm font-mono">
					<span>{author}</span>
					<span class="text-border-light">/</span>
					<time datetime={publishDate.toISOString()}>{formattedDate}</time>
					{formattedUpdatedDate && (
						<>
							<span class="text-border-light">/</span>
							<span>{lang === 'en' ? 'Updated' : 'Aktualisiert'} {formattedUpdatedDate}</span>
						</>
					)}
				</div>
			</header>

			{keyTakeaways && keyTakeaways.length > 0 && (
				<aside class="mb-12 bg-surface border border-border rounded-lg p-6 md:p-8" aria-labelledby="key-takeaways-heading">
					<h2 id="key-takeaways-heading" class="text-xs font-mono uppercase tracking-widest text-primary mb-4">
						{takeawaysHeading}
					</h2>
					<ul class="space-y-2 list-disc list-outside pl-5 text-white/90 leading-relaxed marker:text-primary">
						{keyTakeaways.map(item => <li>{item}</li>)}
					</ul>
				</aside>
			)}

			<!-- Article content -->
			<div class="prose prose-invert prose-lg
				prose-headings:tracking-tight
				prose-h2:font-bold prose-h2:mt-16 prose-h2:mb-6
				prose-h3:font-bold prose-h3:mt-10 prose-h3:mb-4
				prose-p:mb-6 prose-p:leading-8
				prose-a:text-primary prose-a:no-underline hover:prose-a:underline
				prose-strong:text-white
				prose-li:marker:text-primary
				prose-blockquote:border-primary/30 prose-blockquote:not-italic
				prose-code:text-primary prose-code:bg-primary/5 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:font-mono prose-code:text-sm
				prose-pre:bg-surface prose-pre:border prose-pre:border-border prose-pre:rounded-lg
				prose-hr:border-border
				prose-img:rounded-xl prose-img:border prose-img:border-border
			">
				<slot />
			</div>
		{sources && sources.length > 0 && (
			<section class="mt-12 pt-8 border-t border-border" aria-labelledby="sources-heading">
				<h2 id="sources-heading" class="text-heading-sm text-white m-0 mb-4">{sourcesHeading}</h2>
				<ol class="m-0 pl-5 space-y-2 text-sm text-muted list-decimal">
					{sources.map((s) => (
						<li>
							<a href={s.url} target="_blank" rel="noopener" class="text-primary hover:underline break-words">{s.name}</a>{s.retrieved && <span>, {retrievedLabel} {formatRetrieved(s.retrieved)}</span>}
						</li>
					))}
				</ol>
			</section>
		)}
		<!-- Author bio -->
			<div class="mt-16 pt-8 border-t border-border">
				<p class="text-xs font-mono uppercase tracking-widest text-muted mb-3">
					{lang === 'en' ? 'Written by' : 'Geschrieben von'}
				</p>
				<div class="flex items-center gap-4">
					<div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center text-primary font-semibold text-sm">
						{author.charAt(0)}
					</div>
					<div>
						<p class="text-white font-semibold text-sm m-0">{author}</p>
						{!isTeamAuthor(author) && (
							<p class="text-muted text-xs m-0">
								{`${bylineRole}, LearnSlice`}
							</p>
						)}
					</div>
				</div>
			</div>
		</div>

			<!-- On-this-page sidebar (large screens only). The CTA is always rendered so
			     the column is never empty, even on short posts or when the TOC is absent. -->
			<aside class="hidden lg:block">
				<!-- Capped at the viewport height: a long TOC list scrolls inside its own box (the
				     label stays put), so the CTA below always stays on screen instead of being
				     pushed out of the sticky column. 11rem leaves room for the
				     English guide banner above the header before the column sticks. `[&:not([hidden])]:flex` keeps the hidden
				     attribute working, which a plain `flex` class would override. -->
				<div class="sticky top-28 flex flex-col max-h-[calc(100vh-11rem)]">
					<div id="toc-wrap" class="mb-8 min-h-0 [&:not([hidden])]:flex flex-col" hidden>
						<p class="shrink-0 text-xs font-mono uppercase tracking-widest text-muted mb-4">{tocLabel}</p>
						<nav id="toc" aria-label={tocLabel} class="toc-list min-h-0 overflow-y-auto pr-1 flex flex-col border-l border-border text-sm"></nav>
					</div>
					<a
						href={sidebarCta.href}
						data-modal-trigger={sidebarCta.trigger}
						class="group block shrink-0 rounded-lg border border-border bg-surface p-5 hover:border-primary/40 transition-colors"
					>
						<p class="text-white font-semibold text-sm mb-1">{sidebarCta.title}</p>
						<p class="text-muted text-xs mb-3 leading-relaxed">{sidebarCta.sub}</p>
						<span class="inline-flex items-center gap-1 text-primary text-sm font-medium">
							{sidebarCta.button}
							<span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">&rarr;</span>
						</span>
					</a>
				</div>
			</aside>
		</div>
	</article>

	{faq && faq.length > 0 && (
		<section class="py-12 md:py-16 px-6 md:px-8 border-t border-border" aria-labelledby="faq-heading">
			<div class="max-w-2xl mx-auto">
				<h2 id="faq-heading" class="text-heading text-white mb-8 md:mb-10">{faqHeading}</h2>
				<dl class="flex flex-col gap-8">
					{faq.map(({ q, a }) => (
						<div>
							<dt>
								<h3 class="text-lg font-semibold text-white mb-3 leading-snug">{q}</h3>
							</dt>
							<dd class="text-white/80 leading-relaxed m-0">{a}</dd>
						</div>
					))}
				</dl>
			</div>
		</section>
	)}

	{relatedPosts.length > 0 && (
		<section class="py-12 md:py-16 px-6 md:px-8 border-t border-border" aria-labelledby="related-posts-heading">
			<div class="max-w-4xl mx-auto">
				<h2 id="related-posts-heading" class="text-heading text-white mb-8 md:mb-10">{relatedHeading}</h2>
				<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
					{relatedPosts.map(post => (
						<BlogCard
							title={post.data.title}
							description={post.data.description}
							publishDate={post.data.publishDate}
							tags={post.data.tags}
							slug={post.slug}
							lang={lang}
						/>
					))}
				</div>
			</div>
		</section>
	)}

	<CTAFooter
		label={'label' in footerCta ? footerCta.label : undefined}
		headline={footerCta.headline}
		subheadline={footerCta.subheadline}
		button={footerCta.button}
		buttonHref={footerCta.href}
		note={footerCta.note}
		currentLang={lang}
	/>

	<Footer
		currentLang={lang}
		privacyLabel={content.footer.privacyLabel}
		termsLabel={content.footer.termsLabel}
		demoHref={isConsultation ? '#project-inquiry' : '#demo-request'}
	/>

	<!-- Each post renders the modal its CTAs and the site-footer link point to:
	     ConsultationModal (#project-inquiry) for consultation posts, DemoRequestModal
	     (#demo-request) otherwise. A 'guide' post's own CTAs are links rather than
	     modals, but it still renders the demo modal so the sitewide footer's
	     "Request Demo" link is not left dangling. -->
	{isConsultation ? <ConsultationModal currentLang={lang} /> : <DemoRequestModal currentLang={lang} />}

	<script type="application/ld+json" set:html={JSON.stringify(blogPostingSchema).replace(/<\/script/gi, '<\\/script')} />
	{faqPageSchema && (
		<script type="application/ld+json" set:html={JSON.stringify(faqPageSchema).replace(/<\/script/gi, '<\\/script')} />
	)}

	<style is:global>
		html { scroll-behavior: smooth; }
		@media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
		/* Bottom fade on the sidebar TOC while it has more entries below (see initBlogToc). */
	.toc-list.toc-more {
		-webkit-mask-image: linear-gradient(to bottom, #000 calc(100% - 2.5rem), transparent);
		mask-image: linear-gradient(to bottom, #000 calc(100% - 2.5rem), transparent);
	}
</style>

	<script>
		let tocObserver = null;
		let tocFadeOnResize = null;

		function initBlogToc() {
			// Re-initialised on view-transition navigations: drop the old observer first.
			if (tocObserver) { tocObserver.disconnect(); tocObserver = null; }
			if (tocFadeOnResize) { window.removeEventListener('resize', tocFadeOnResize); tocFadeOnResize = null; }

			const article = document.querySelector('article .prose');
			const nav = document.getElementById('toc');
			const wrap = document.getElementById('toc-wrap');
			if (!article || !nav || !wrap) return;

			// Components embedded in the article (the InlineCta panel) carry their own
			// heading, and `not-prose` only suppresses typography styles, not this
			// selector. Without the filter a marketing headline lands in the TOC as if
			// it were a section of the post, and can become the active entry on scroll.
			const headings = Array.from(article.querySelectorAll('h2'))
				.filter((h) => !h.closest('.not-prose'));
			// A table of contents only earns its space with a few sections.
			if (headings.length < 3) { nav.innerHTML = ''; wrap.hidden = true; return; }

			// Unicode-aware: keep letters/digits from any script (German umlauts, ß),
			// so the fallback never mangles an id if a heading ships without one.
			const slugify = (text) => {
				const s = text.toLowerCase().trim()
					.replace(/[^\p{L}\p{N}\s-]/gu, '')
					.replace(/\s+/g, '-')
					.replace(/-+/g, '-')
					.replace(/^-+|-+$/g, '');
				return s || 'section';
			};

			nav.innerHTML = '';
			const linkById = {};
			const used = new Set();

			headings.forEach((h) => {
				if (!h.id) {
					let base = slugify(h.textContent || '');
					let id = base, i = 2;
					while (used.has(id) || document.getElementById(id)) { id = `${base}-${i++}`; }
					h.id = id;
				}
				used.add(h.id);
				h.style.scrollMarginTop = '7rem';

				const a = document.createElement('a');
				a.href = '#' + h.id;
				a.textContent = h.textContent;
				a.className = 'block -ml-px border-l-2 border-transparent pl-4 py-1 text-muted hover:text-white leading-snug transition-colors';
				nav.appendChild(a);
				linkById[h.id] = a;
			});

			wrap.hidden = false;

			// Fade the bottom edge while more entries sit below the visible part of the list.
			const updateFade = () => nav.classList.toggle('toc-more', nav.scrollTop + nav.clientHeight < nav.scrollHeight - 2);
			nav.onscroll = updateFade;
			tocFadeOnResize = updateFade;
			window.addEventListener('resize', updateFade, { passive: true });
			requestAnimationFrame(updateFade);

			let active = null;
			const setActive = (id) => {
				const link = linkById[id];
				if (!link || link === active) return;
				if (active) active.classList.remove('text-white', 'border-primary');
				active = link;
				active.classList.add('text-white', 'border-primary');
				// Keep the active entry visible when the TOC box scrolls (long posts).
				// Adjusts only the box, never the page.
				const box = nav.getBoundingClientRect(), r = link.getBoundingClientRect();
				if (r.top < box.top) nav.scrollTop -= box.top - r.top + 8;
				else if (r.bottom > box.bottom) nav.scrollTop += r.bottom - box.bottom + 8;
			};

			tocObserver = new IntersectionObserver((entries) => {
				const visible = entries.filter((e) => e.isIntersecting)
					.sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
				if (visible.length) setActive(visible[0].target.id);
			}, { rootMargin: '-80px 0px -70% 0px', threshold: 0 });

			headings.forEach((h) => tocObserver.observe(h));
		}

		if (document.readyState !== 'loading') initBlogToc();
		else document.addEventListener('DOMContentLoaded', initBlogToc);
		document.addEventListener('astro:page-load', initBlogToc);
	</script>
</BaseLayout>

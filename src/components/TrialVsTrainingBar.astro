---
// Schematic for the Berichtsheft software comparison posts: a trial covers a short
// stretch at the start, while the record has to be complete across the whole
// apprenticeship (§ 5 Abs. 1 Nr. 2 BBiG: usually two to three years) and is needed for
// exam admission (§ 43 Abs. 1 Nr. 2 BBiG). The trial width is illustrative on purpose:
// no trial length is claimed, each provider sets its own (see the note).
// Plain HTML so it stays readable on phones. Sits inside `prose`, hence `not-prose`.
interface Props {
	lang: 'en' | 'de';
}

const { lang } = Astro.props;
if (lang !== 'de' && lang !== 'en') throw new Error(`TrialVsTrainingBar: unsupported lang "${lang}"`);

const t = lang === 'de'
	? {
		label: 'Schematisch',
		title: 'Was eine Testphase abdeckt und was der Nachweis abdecken muss',
		years: ['Jahr 1', 'Jahr 2', 'Jahr 3'],
		trial: 'Testphase',
		record: 'Berichtsheft: lückenlos über die ganze Ausbildung',
		exam: 'Prüfungsanmeldung: vollständiger Nachweis nötig (§ 43 BBiG)',
		note: 'Eine Ausbildung dauert in der Regel zwei bis drei Jahre (§ 5 BBiG). Die Länge einer Testphase legt jeder Anbieter selbst fest.',
	}
	: {
		label: 'Schematic',
		title: 'What a trial covers and what the record has to cover',
		years: ['Year 1', 'Year 2', 'Year 3'],
		trial: 'Trial',
		record: 'Training logbook: complete across the whole apprenticeship',
		exam: 'Exam registration: complete record required (§ 43 BBiG)',
		note: 'An apprenticeship usually lasts two to three years (§ 5 BBiG). Each provider sets the length of its own trial.',
	};
---

<figure class="not-prose my-10 rounded-xl border border-border bg-surface p-6 md:p-8">
	<figcaption class="m-0 mb-6">
		<span class="section-label block mb-2">{t.label}</span>
		<span class="block text-heading-sm text-white">{t.title}</span>
	</figcaption>

	<div class="grid grid-cols-3 gap-1 text-[11px] md:text-xs font-mono uppercase tracking-wider text-muted mb-2" aria-hidden="true">
		{t.years.map((y) => <span>{y}</span>)}
	</div>

	<div class="relative h-10 rounded-lg bg-primary/25 ring-1 ring-primary/40 overflow-hidden" aria-hidden="true">
		<div class="absolute inset-y-0 left-0 w-[6%] min-w-[14px] bg-accent"></div>
		<div class="absolute inset-y-0 left-1/3 w-px bg-white/15"></div>
		<div class="absolute inset-y-0 left-2/3 w-px bg-white/15"></div>
		<div class="absolute inset-y-0 right-0 w-1 bg-white"></div>
	</div>

	<ul class="m-0 mt-5 p-0 space-y-3" style="list-style:none">
		<li class="flex items-start gap-3 text-sm text-white m-0" style="list-style:none">
			<span class="mt-1 h-3 w-3 shrink-0 rounded-sm bg-accent" aria-hidden="true"></span>
			<span>{t.trial}</span>
		</li>
		<li class="flex items-start gap-3 text-sm text-white m-0" style="list-style:none">
			<span class="mt-1 h-3 w-3 shrink-0 rounded-sm bg-primary/25 ring-1 ring-primary/40" aria-hidden="true"></span>
			<span>{t.record}</span>
		</li>
		<li class="flex items-start gap-3 text-sm text-white m-0" style="list-style:none">
			<span class="mt-1 h-3 w-1 ml-1 mr-1 shrink-0 bg-white" aria-hidden="true"></span>
			<span>{t.exam}</span>
		</li>
	</ul>

	<p class="text-xs text-muted/80 m-0 mt-6">{t.note}</p>
</figure>

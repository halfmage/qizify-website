---
// "Ihr eigener Begleiter" band on the custom development page (/de/loesungen, /solutions).
// Target of the homepage companion card and the nav item; links back to the three
// companion pages so examples and the build path point at each other.
import Button from './Button.astro';
import { Icon } from 'astro-icon/components';

interface Props {
	lang: 'en' | 'de';
	// Label of the page's project-inquiry CTA, so the button matches the rest of the page
	ctaLabel: string;
}

const { lang, ctaLabel } = Astro.props;

const copy = {
	de: {
		label: 'Ihr eigener Begleiter',
		headline: 'Ihr eigener Begleiter. Auf derselben Engine.',
		sub: 'Ihr Thema, Ihre Inhalte, Ihre Marke. Wir richten den Begleiter auf Ihre Ziele und Ihre Lernenden aus.',
		steps: [
			{ icon: 'hugeicons:upload-02', title: 'Inhalte hochladen', body: 'Handbücher, Lehrpläne, Prozesse: Der Begleiter antwortet daraus und nennt die Quelle.' },
			{ icon: 'hugeicons:target-02', title: 'Ziel festlegen', body: 'Wofür und für wen? Lernweg, Quizze und Simulationen richten sich danach.' },
			{ icon: 'hugeicons:paint-board', title: 'Marke wählen', body: 'Name, Farben, Logo. Gehostet in Deutschland oder bei Ihnen.' },
		],
		examplesLabel: 'Beispiele auf derselben Engine:',
		examples: [
			{ label: 'KI-Tutor für die Ausbildung', href: '/de/ki-tutor-ausbildung' },
			{ label: 'Finanz-Begleiter', href: '/de/finanz-begleiter' },
			{ label: 'Gründer-Begleiter', href: '/de/gruender-begleiter' },
		],
		imageAlt: 'Eigener Begleiter in drei Schritten: Inhalte hochladen, Ziel festlegen, Marke wählen, daneben die Vorschau eines Service-Begleiters mit Lernweg, Antwort mit Quelle und Simulation',
		caption: 'Beispieldarstellung mit fiktiven Daten.',
	},
	en: {
		label: 'Your own companion',
		headline: 'Your own companion. On the same engine.',
		sub: 'Your topic, your content, your brand. We set the companion up for your goals and your learners.',
		steps: [
			{ icon: 'hugeicons:upload-02', title: 'Upload content', body: 'Manuals, curricula, processes: the companion answers from them and names the source.' },
			{ icon: 'hugeicons:target-02', title: 'Set the goal', body: 'What for and for whom? The learning path, quizzes and simulations follow from it.' },
			{ icon: 'hugeicons:paint-board', title: 'Choose your brand', body: 'Name, colours, logo. Hosted in Germany or on your own servers.' },
		],
		examplesLabel: 'Examples on the same engine:',
		examples: [
			{ label: 'AI tutor for apprenticeships', href: '/ai-tutor-apprenticeships' },
			{ label: 'Financial Companion', href: '/financial-companion' },
			{ label: 'Founder Companion', href: '/founder-companion' },
		],
		imageAlt: 'Your own companion in three steps: upload content, set the goal, choose your brand, next to a preview of a service companion with a learning path, a sourced answer and a simulation',
		caption: 'Example screen with fictional data.',
	},
}[lang];
---

<section id={lang === 'de' ? 'eigener-begleiter' : 'own-companion'} class="py-12 md:py-20 px-6 md:px-8 scroll-mt-20">
	<div class="max-w-container mx-auto">
		<div class="text-center mb-12 max-w-2xl mx-auto">
			<span class="section-label mb-4 block">{copy.label}</span>
			<h2 class="text-heading md:text-display-sm text-white m-0 mb-4 text-balance">{copy.headline}</h2>
			<p class="text-lg text-muted leading-relaxed m-0">{copy.sub}</p>
		</div>
		<div class="p-2 md:p-4 rounded-2xl bg-gradient-to-b from-primary/10 to-primary/30 ring-1 ring-primary/20 max-w-5xl mx-auto">
			<img src={`/images/solutions/custom-companion-${lang}.webp`} alt={copy.imageAlt} width="2900" height="1520" loading="lazy" decoding="async" class="w-full h-auto block rounded-lg" />
		</div>
		<p class="text-xs text-white/50 text-center m-0 mt-4">{copy.caption}</p>
		<div class="grid grid-cols-1 lg:grid-cols-3 gap-px bg-border rounded-xl overflow-hidden mt-10">
			{copy.steps.map((step, i) => (
				<div class="bg-surface p-7">
					<div class="flex items-center gap-3 mb-3">
						<div class="w-11 h-11 rounded-lg bg-primary/10 flex items-center justify-center shrink-0">
							<Icon name={step.icon} class="w-5 h-5 text-primary" />
						</div>
						<h3 class="text-base font-semibold text-white m-0 flex-1">{step.title}</h3>
						<span class="font-mono text-label text-primary/70 shrink-0">{String(i + 1).padStart(2, '0')}</span>
					</div>
					<p class="text-sm text-muted leading-relaxed m-0">{step.body}</p>
				</div>
			))}
		</div>
		<div class="flex flex-col md:flex-row items-center justify-center gap-x-6 gap-y-4 mt-10">
			<p class="text-sm text-muted m-0 text-center">
				{copy.examplesLabel}
				{copy.examples.map((ex, i) => (
					<>{i > 0 && ' · '}<a href={ex.href} class="text-white underline underline-offset-4 decoration-white/30 hover:decoration-white">{ex.label}</a></>
				))}
			</p>
			<Button variant="primary" href="#project-inquiry" data-modal-trigger="project-inquiry" aria-label={ctaLabel}>{ctaLabel}</Button>
		</div>
	</div>
</section>

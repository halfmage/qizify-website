---
// Contact card for the companion pages: a short Netlify form plus a direct Calendly link.
// The script also handles any other form[data-lead-form] on the page (e.g. a waitlist),
// posting to Netlify Forms via fetch so the result shows inline.
interface Props {
	// Netlify form name, e.g. "founder-pilot"
	name: string;
	lang: 'en' | 'de';
	error: string;
	form: {
		name: string;
		org: string;
		type: string;
		choose: string;
		typeOptions: string[];
		email: string;
		message: string;
		optional: string;
		submit: string;
		note: string;
		calendly: string;
		success: string;
		successCalendly: string;
		privacy: { pre: string; link: string; post: string };
	};
}

const { name, lang, error, form } = Astro.props;
const calendly = 'https://calendly.com/learnslice-team/30min';
const privacyHref = lang === 'de' ? '/de/privacy' : '/privacy';
const inputClass = 'bg-input-bg border border-border-light rounded-lg px-4 py-2.5 text-sm text-white font-sans w-full focus:outline-none focus:border-primary transition-colors duration-200 placeholder:text-muted';
---

<div class="bg-surface border border-border-light rounded-2xl p-7 md:p-9">
	<form name={name} method="POST" data-netlify="true" netlify-honeypot="bot-field" class="flex flex-col gap-5" data-lead-form>
		<input type="hidden" name="form-name" value={name} />
		<input type="hidden" name="language" value={lang} />
		<input type="text" name="bot-field" class="hidden" tabindex="-1" autocomplete="off" />
		<div class="grid sm:grid-cols-2 gap-5">
			<label class="flex flex-col gap-1.5 text-sm font-medium text-white/80">{form.name}
				<input type="text" name="name" autocomplete="name" required class={inputClass} />
			</label>
			<label class="flex flex-col gap-1.5 text-sm font-medium text-white/80">{form.org}
				<input type="text" name="organisation" autocomplete="organization" required class={inputClass} />
			</label>
		</div>
		<label class="flex flex-col gap-1.5 text-sm font-medium text-white/80">{form.type}
			<select name="organisation-type" class={inputClass}>
				<option value="" selected>{form.choose}</option>
				{form.typeOptions.map((o) => <option value={o}>{o}</option>)}
			</select>
		</label>
		<label class="flex flex-col gap-1.5 text-sm font-medium text-white/80">{form.email}
			<input type="email" name="email" autocomplete="email" required class={inputClass} />
		</label>
		<label class="flex flex-col gap-1.5 text-sm font-medium text-white/80">{form.message}
			<textarea name="message" rows="3" placeholder={form.optional} class={`${inputClass} min-h-[80px] resize-y`}></textarea>
		</label>
		<p class="hidden p-3 rounded-lg text-xs bg-red-500/10 border border-red-500/20 text-red-300 m-0" data-form-error role="alert">{error}</p>
		<p class="hidden p-3 rounded-lg text-sm bg-green-500/10 border border-green-500/20 text-green-300 m-0" data-form-success role="status">{form.success} <a href={calendly} target="_blank" rel="noopener noreferrer" class="underline font-medium text-white">{form.successCalendly}</a></p>
		<button type="submit" class="bg-primary text-white border-none rounded-full px-6 py-3 text-base font-medium cursor-pointer hover:bg-[#6a4ae0] transition-colors font-sans disabled:opacity-50">{form.submit}</button>
		<p class="text-xs text-muted text-center m-0">{form.note}</p>
		<p class="text-xs text-muted/80 text-center m-0">{form.privacy.pre} <a href={privacyHref} target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">{form.privacy.link}</a>{form.privacy.post}</p>
	</form>
	<a href={calendly} target="_blank" rel="noopener noreferrer" class="block text-center text-sm text-white/80 hover:text-white underline underline-offset-4 decoration-white/30 mt-3 py-2">{form.calendly}</a>
</div>

<script>
	document.querySelectorAll<HTMLFormElement>('form[data-lead-form]').forEach((form) => {
		const error = form.querySelector('[data-form-error]');
		const success = form.querySelector('[data-form-success]');
		const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			error?.classList.add('hidden');
			success?.classList.add('hidden');
			if (button) button.disabled = true;
			try {
				const response = await fetch('/', {
					method: 'POST',
					headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
					body: new URLSearchParams(new FormData(form) as any).toString(),
				});
				if (!response.ok) throw new Error('Form submission failed');
				success?.classList.remove('hidden');
				form.reset();
			} catch {
				error?.classList.remove('hidden');
			} finally {
				if (button) button.disabled = false;
			}
		});
	});
</script>

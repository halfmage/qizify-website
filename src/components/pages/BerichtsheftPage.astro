---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../Header.astro';
import FAQ from '../FAQ.astro';
import Footer from '../Footer.astro';
import Button from '../Button.astro';
import StickyCta from '../StickyCta.astro';
import DemoRequestModal from '../DemoRequestModal.astro';
import TrustBar from '../TrustBar.astro';
import AnnouncementPill from '../AnnouncementPill.astro';
import AppScreenshot from '../AppScreenshot.astro';
import { Icon } from 'astro-icon/components';
import enContent from '../../content/en.json';
import deContent from '../../content/de.json';
import berichtsheft from '../../content/berichtsheft.json';
import { SITE } from '../../utils/page-pairs.mjs';
import { signupUrl } from '../../data/berichtsheft.mjs';
import AzubiShare from '../AzubiShare.astro';

// Free Berichtsheft landing page, for /de/berichtsheft-kostenlos and
// /free-training-logbook. Launched with the free tier on 2026-11-10.
// Copy: src/content/berichtsheft.json (also feeds public/llms-full.txt).
// Every feature claim must match the free plan in learnslice-sme (lib/plan.ts and the
// Berichtsheft routes). Rules: no competitor or IHK successor tool named, nothing that
// implies LearnSlice is the only free option, no Premium price on the page (it is shown
// in the app), legal statements only with the BBiG section and a pointer to the Kammer.
interface Props {
	lang: 'en' | 'de';
}

const { lang } = Astro.props;
const content = lang === 'de' ? deContent : enContent;
const copy = berichtsheft[lang];
// Real app screenshots (sample data, 2880x1800): how-it-works and features sections.
const heroLines = copy.hero.headline.split(/(?<=\.)\s+/);
// 1200x630 JPG, same card as the Berichtsheft guide
const ogImage = '/images/blog/pexels-mikhail-nilov-9242810.jpg';
const href = (placement: string) => signupUrl(`landing-${lang}-${placement}`);

// The page is about the free Berichtsheft, not the AI platform, so BaseLayout's
// platform SoftwareApplication is switched off and this one is emitted instead.
const softwareSchema = {
	'@context': 'https://schema.org',
	'@type': 'SoftwareApplication',
	name: lang === 'de' ? 'LearnSlice-Berichtsheft' : 'LearnSlice Training Logbook',
	applicationCategory: 'BusinessApplication',
	operatingSystem: 'Web',
	url: `${SITE}${copy.path}`,
	description: copy.answer.body,
	inLanguage: lang === 'de' ? 'de-DE' : 'en',
	offers: {
		'@type': 'Offer',
		price: '0',
		priceCurrency: 'EUR',
		description: copy.plans.free.items.join(', '),
	},
	publisher: { '@type': 'Organization', name: 'LearnSlice', url: SITE },
};
---

<BaseLayout
	title={copy.title}
	description={copy.description}
	lang={lang}
	currentPath={copy.path}
	breadcrumbTitle={copy.breadcrumb}
	ogImage={ogImage}
	softwareSchema={false}
>
	<script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />

	<Header logo={content.nav.logo} menu={content.nav.menu} cta={copy.cta} ctaHref={href('nav')} currentLang={lang} currentPath={copy.path} />

	<!-- Hero: punchy promise left, the real app (all entries view) right -->
	<section class="bh-hero relative overflow-hidden pt-28 md:pt-36 pb-16 md:pb-24 px-6 md:px-8">
		<div class="absolute inset-0 glow-aurora opacity-70 pointer-events-none" aria-hidden="true"></div>
		<div class="bh-ruled absolute inset-0 pointer-events-none" aria-hidden="true"></div>
		<div class="relative z-10 max-w-container mx-auto grid xl:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] gap-14 xl:gap-14 items-center">
			<div class="text-center xl:text-left">
				<div class="bh-rise" style="--d:0ms" data-deadline-pill>
					<AnnouncementPill {...copy.hero.pill} class="mb-7" />
				</div>
				<h1 class="bh-rise text-white m-0 tracking-tight" style="--d:80ms">
					<span class="block text-base md:text-lg font-semibold text-white/70 tracking-normal mb-4">{copy.hero.eyebrow}<span class="sr-only">:</span></span>
					<span class="block text-[clamp(2.4rem,1.4rem+3.6vw,4.1rem)] leading-[1.04] font-bold tracking-[-0.035em]">
						{heroLines.map((line) => <span class="block">{line}</span>)}
						<span class="block gradient-text-primary">{copy.hero.headlineAccent}</span>
					</span>
				</h1>
				<p class="bh-rise text-lg md:text-xl leading-relaxed text-white/80 text-balance m-0 mt-7 max-w-xl mx-auto xl:mx-0" style="--d:160ms">{copy.hero.sub}</p>
				<div class="bh-rise flex flex-col sm:flex-row justify-center xl:justify-start gap-3 mt-9" style="--d:240ms">
					<Button variant="primary" size="lg" href={href('hero')} class="!rounded-full shadow-[0_10px_40px_-8px_rgba(124,92,252,0.7)]">{copy.cta} <span class="ml-1.5" aria-hidden="true">&rarr;</span></Button>
					<Button variant="secondary" size="lg" href="#so-funktioniert" class="!rounded-full !border-white/30 !text-white hover:!border-white/60 hover:!bg-white/5">
						{copy.hero.secondary} <span class="ml-1.5" aria-hidden="true">&rsaquo;</span>
					</Button>
				</div>
				<ul class="bh-rise flex flex-wrap justify-center xl:justify-start gap-x-5 gap-y-2 list-none p-0 m-0 mt-6" style="--d:320ms">
					{copy.hero.facts.map((f) => (
						<li class="inline-flex items-center gap-1.5 text-sm text-white/75"><Icon name="hugeicons:checkmark-circle-02" class="w-4 h-4 text-primary" />{f}</li>
					))}
				</ul>
			</div>

			<!-- Real app screenshot (sample data), fitted to the column. The crop without the
			     sidebar keeps the table (entries, status, Prüfen, PDF) readable at this size. -->
			<figure class="relative m-0 min-w-0 w-full max-w-3xl mx-auto bh-rise" style="--d:200ms">
				<div class="absolute -inset-8 rounded-[2.5rem] bg-primary/25 blur-3xl" aria-hidden="true"></div>
				<div class="relative rounded-2xl p-2 md:p-2.5 bg-gradient-to-br from-primary/60 via-primary/25 to-accent/40 shadow-[0_40px_100px_-20px_rgba(0,0,0,0.8)]">
					<img src={copy.screens.entries.mobileSrc} alt={copy.screens.entries.alt} width={copy.screens.entries.mobileWidth} height={copy.screens.entries.mobileHeight} loading="eager" fetchpriority="high" decoding="async" class="block w-full h-auto rounded-xl" />
				</div>
				<figcaption class="relative text-[11px] text-white/45 mt-4 text-center xl:text-left">{copy.screens.note}</figcaption>
			</figure>
		</div>
	</section>

	<!-- Who is behind the free tool: the site-wide facts (FH Dortmund, BMWE-funded research, hosting) -->
	<TrustBar currentLang={lang} center={true} />

	<!-- Value in four numbers -->
	<section class="px-6 md:px-8 py-14 md:py-20">
		<ul class="max-w-container mx-auto grid grid-cols-2 lg:grid-cols-4 gap-px bg-border rounded-2xl overflow-hidden list-none p-0 m-0">
			{copy.value.items.map((v) => (
				<li class="bg-dark p-6 md:p-8 card-hover-glow card-hover-glow-primary">
					<span class="block text-3xl sm:text-4xl md:text-5xl font-semibold tracking-tight gradient-text-primary leading-none whitespace-nowrap">{v.big}</span>
					<span class="block text-sm text-muted leading-relaxed mt-3">{v.text}</span>
				</li>
			))}
		</ul>
	</section>

	<!-- Before / after: paper and Word vs LearnSlice -->
	<section class="py-16 md:py-24 px-6 md:px-8 border-t border-border/50">
		<div class="max-w-5xl mx-auto">
			<div class="text-center mb-12 max-w-2xl mx-auto">
				<span class="section-label mb-4 block">{copy.compare.label}</span>
				<h2 class="text-heading md:text-display-sm text-white m-0 text-balance">{copy.compare.headline}</h2>
			</div>
			<div class="grid md:grid-cols-2 gap-4">
				<div class="rounded-2xl border border-border bg-surface/40 p-7">
					<h3 class="font-mono text-label uppercase tracking-widest text-white/50 m-0 mb-6">{copy.compare.before}</h3>
					<ul class="list-none p-0 m-0 space-y-4">
						{copy.compare.rows.map(([before]) => (
							<li class="flex items-start gap-3 text-base text-white/50"><Icon name="hugeicons:cancel-circle" class="w-5 h-5 text-white/30 shrink-0 mt-0.5" /><span>{before}</span></li>
						))}
					</ul>
				</div>
				<div class="relative rounded-2xl p-px bg-gradient-to-br from-primary via-primary/40 to-accent/60 shadow-[0_0_60px_-10px_rgba(124,92,252,0.45)]">
					<div class="h-full rounded-2xl bg-[#202024] p-7">
						<h3 class="font-mono text-label uppercase tracking-widest text-primary m-0 mb-6">{copy.compare.after}</h3>
						<ul class="list-none p-0 m-0 space-y-4">
							{copy.compare.rows.map(([, after]) => (
								<li class="flex items-start gap-3 text-base text-white"><Icon name="hugeicons:checkmark-circle-02" class="w-5 h-5 text-primary shrink-0 mt-0.5" />{after}</li>
							))}
						</ul>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Vision: editorial statement, signed -->
	<section class="relative overflow-hidden py-16 md:py-24 px-6 md:px-8 border-t border-border/50">
		<div class="absolute inset-0 pointer-events-none bg-[radial-gradient(ellipse_60%_60%_at_50%_0%,rgba(124,92,252,0.18),transparent_70%)]" aria-hidden="true"></div>
		<div class="relative max-w-4xl mx-auto text-center">
			<span class="section-label mb-6 block">{copy.why.label}</span>
			<h2 class="text-[clamp(1.9rem,1.1rem+3vw,3.25rem)] leading-[1.1] font-semibold tracking-[-0.03em] text-white m-0 text-balance">
				{copy.why.headline.split(/(?<=\.)\s+/).map((line, i) => <span class={`block ${i > 0 ? 'gradient-text-primary' : ''}`}>{line}</span>)}
			</h2>
			<p class="text-lg text-muted leading-relaxed m-0 mt-6 max-w-xl mx-auto text-balance">{copy.why.body}</p>
		</div>
	</section>

	<!-- How it works: answer first (quotable), steps, real screenshot -->
	<section id="so-funktioniert" class="py-16 md:py-24 px-6 md:px-8 border-t border-border/50 scroll-mt-20">
		<div class="max-w-container mx-auto">
			<div class="max-w-3xl mb-12">
				<span class="section-label mb-4 block">{copy.how.label}</span>
				<h2 class="text-heading md:text-display-sm text-white m-0 mb-4">{copy.answer.headline}</h2>
				<p class="text-lg text-muted leading-relaxed m-0">{copy.answer.body}</p>
			</div>
			<div class="grid grid-cols-1 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] gap-10 items-center">
				<div>
					<h3 class="text-heading-sm text-white m-0 mb-6">{copy.how.headline}</h3>
					<ol class="list-none p-0 m-0 relative">
						{copy.how.steps.map((step, i) => (
							<li class="relative flex gap-4 pb-8 last:pb-0">
								{i < copy.how.steps.length - 1 && <span class="absolute left-[21px] top-12 bottom-1 w-px bg-gradient-to-b from-primary/60 to-border" aria-hidden="true"></span>}
								<span class="w-11 h-11 rounded-xl bg-primary/15 ring-1 ring-primary/30 flex items-center justify-center shrink-0">
									<Icon name={step.icon} class="w-5 h-5 text-primary" />
								</span>
								<div>
									<p class="font-mono text-label uppercase tracking-widest text-primary/70 m-0 mb-1">{String(i + 1).padStart(2, '0')}</p>
									<h4 class="text-base font-semibold text-white m-0 mb-1">{step.title}</h4>
									<p class="text-sm text-muted leading-relaxed m-0">{step.body}</p>
								</div>
							</li>
						))}
					</ol>
				</div>
				<AppScreenshot {...copy.screens.apprentices} note={copy.screens.note} hint={copy.screens.hint} />
			</div>
		</div>
	</section>

	<!-- What the free plan includes -->
	<section class="py-16 md:py-24 px-6 md:px-8 border-t border-border/50">
		<div class="max-w-container mx-auto">
			<div class="text-center mb-12 max-w-2xl mx-auto">
				<span class="section-label mb-4 block">{copy.features.label}</span>
				<h2 class="text-heading md:text-display-sm text-white m-0">{copy.features.headline}</h2>
			</div>
			<ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-10 gap-y-6 list-none p-0 m-0 max-w-5xl mx-auto">
				{copy.features.items.map((item) => (
					<li class="flex items-start gap-3">
						<Icon name="hugeicons:checkmark-circle-02" class="w-5 h-5 text-primary shrink-0 mt-0.5" />
						<div>
							<h3 class="text-base font-semibold text-white m-0 mb-1">{item.title}</h3>
							<p class="text-sm text-muted leading-relaxed m-0">{item.body}</p>
						</div>
					</li>
				))}
			</ul>
			<div class="flex flex-col items-center gap-3 mt-12">
				<Button variant="primary" size="lg" href={href('features')} class="!rounded-full">{copy.cta}</Button>
				<p class="text-sm text-white/70 m-0">{copy.features.cta.note}</p>
			</div>
		</div>
	</section>

	<!-- Free vs Premium -->
	<section class="py-16 md:py-24 px-6 md:px-8 border-t border-border/50">
		<div class="max-w-4xl mx-auto">
			<div class="text-center mb-12">
				<span class="section-label mb-4 block">{copy.plans.label}</span>
				<h2 class="text-heading md:text-display-sm text-white m-0 text-balance">{copy.plans.headline}</h2>
			</div>
			<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
				<div class="bg-surface border border-primary/50 rounded-2xl p-7 flex flex-col">
					<h3 class="text-lg font-semibold text-white m-0">{copy.plans.free.name}</h3>
					<p class="m-0 mt-3"><span class="text-4xl font-semibold text-white">{copy.plans.free.price}</span> <span class="text-sm text-muted">{copy.plans.free.priceNote}</span></p>
					<ul class="list-none p-0 m-0 mt-6 space-y-2.5 flex-1">
						{copy.plans.free.items.map((f) => (
							<li class="flex items-start gap-2 text-sm text-white/90"><Icon name="hugeicons:checkmark-circle-02" class="w-4 h-4 text-primary shrink-0 mt-0.5" />{f}</li>
						))}
					</ul>
					<Button variant="primary" href={href('plans')} class="!rounded-full mt-7 self-start">{copy.cta}</Button>
				</div>
				<div class="bg-surface border border-border rounded-2xl p-7 flex flex-col">
					<h3 class="text-lg font-semibold text-white m-0">{copy.plans.premium.name}</h3>
					<p class="text-sm text-muted m-0 mt-3">{copy.plans.premium.priceNote}</p>
					<p class="text-sm font-semibold text-white m-0 mt-6 mb-2.5">{copy.plans.premium.heading}</p>
					<ul class="list-none p-0 m-0 space-y-2.5 flex-1">
						{copy.plans.premium.items.map((f) => (
							<li class="flex items-start gap-2 text-sm text-white/90"><Icon name="hugeicons:checkmark-circle-02" class="w-4 h-4 text-primary shrink-0 mt-0.5" />{f}</li>
						))}
					</ul>
					<!-- Premium path for companies that outgrow Free: the 30-minute demo (no price on the website) -->
					<Button variant="secondary" href="#demo-request" data-modal-trigger="demo-request" class="!rounded-full mt-7 self-start !border-white/30 !text-white hover:!border-white/60 hover:!bg-white/5">{copy.plans.premium.cta}</Button>
				</div>
			</div>
			<p class="text-base text-white/85 text-center m-0 mt-8 text-balance">{copy.plans.moreThanFree}</p>
			<p class="text-sm text-muted text-center m-0 mt-2">{copy.plans.upgradeNote}</p>
		</div>
	</section>

	<!-- Switching from the IHK tool -->
	<section id="wechsel" class="py-16 md:py-24 px-6 md:px-8 border-t border-border/50 scroll-mt-20">
		<div class="max-w-3xl mx-auto">
			<div class="text-center mb-10">
				<span class="section-label mb-4 block">{copy.switch.label}</span>
				<h2 class="text-heading md:text-display-sm text-white m-0">{copy.switch.headline}</h2>
				<p class="text-base text-muted m-0 mt-4 text-balance">{copy.switch.intro}{' '}<a href={copy.switch.introLink.href} class="text-primary underline hover:text-white">{copy.switch.introLink.label}</a></p>
			</div>
			<ol class="list-none p-0 m-0 space-y-5">
				{copy.switch.steps.map((step, i) => (
					<li class="flex items-start gap-4">
						<span class="w-8 h-8 rounded-full bg-primary/15 text-primary font-mono text-sm flex items-center justify-center shrink-0">{i + 1}</span>
						<div>
							<h3 class="text-base font-semibold text-white m-0 mb-1">{step.title}</h3>
							<p class="text-sm text-muted leading-relaxed m-0">{step.body}</p>
						</div>
					</li>
				))}
			</ol>
			<p class="text-sm text-white/70 m-0 mt-8">{copy.switch.note}</p>
		</div>
	</section>

	<FAQ headline={copy.faqHeadline} items={copy.faq} />

	<!-- Final CTA -->
	<section id="start" class="py-16 md:py-24 px-6 md:px-8 border-t border-border/50 scroll-mt-20">
		<!-- Closing panel: same aurora and gradient hairline as the hero, so the page ends where it started -->
		<div class="relative max-w-5xl mx-auto rounded-3xl p-px bg-gradient-to-br from-primary via-primary/40 to-accent/60 shadow-[0_0_80px_-20px_rgba(124,92,252,0.55)]">
			<div class="relative overflow-hidden rounded-3xl bg-[#1d1d21] px-6 py-14 md:px-16 md:py-20 text-center">
				<div class="absolute inset-0 glow-aurora opacity-60 pointer-events-none" aria-hidden="true"></div>
				<div class="bh-ruled absolute inset-0 pointer-events-none" aria-hidden="true"></div>
				<div class="relative">
					<h2 class="text-[clamp(1.9rem,1.1rem+3vw,3.25rem)] leading-[1.08] font-semibold tracking-[-0.03em] text-white m-0 mb-5 text-balance">{copy.final.headline}</h2>
					<p class="text-lg text-white/80 leading-relaxed m-0 mb-9 max-w-xl mx-auto text-balance">{copy.final.sub}</p>
					<Button variant="primary" size="lg" href={href('final')} class="!rounded-full shadow-[0_10px_40px_-8px_rgba(124,92,252,0.7)]">{copy.cta} <span class="ml-1.5" aria-hidden="true">&rarr;</span></Button>
					<p class="text-sm text-white/75 m-0 mt-5 max-w-lg mx-auto text-balance">{copy.final.note}{' '}<AzubiShare lang={lang} class="text-white" /></p>
				</div>
			</div>
		</div>
		<p class="text-xs text-white/50 text-center m-0 mt-12 max-w-2xl mx-auto">{copy.disclaimer}</p>
		<p class="text-xs text-white/50 text-center m-0 mt-2 max-w-2xl mx-auto">{copy.appLegal.pre} <a href="https://app.learnslice.com/terms" target="_blank" rel="noopener noreferrer" class="underline hover:text-white">{copy.appLegal.terms}</a> {copy.appLegal.and} <a href="https://app.learnslice.com/privacy" target="_blank" rel="noopener noreferrer" class="underline hover:text-white">{copy.appLegal.privacy}</a> {copy.appLegal.post}</p>
	</section>

	<!-- Footer keeps its "request demo" link: the modal below is the Premium path -->
	<Footer currentLang={lang} privacyLabel={content.footer.privacyLabel} termsLabel={content.footer.termsLabel} />

	<!-- Mobile sticky CTA: appears after the hero, hides while the final CTA is on screen -->
	<StickyCta label={copy.cta} href={href('sticky')} hideWhileVisible="#start" />

	<DemoRequestModal currentLang={lang} />
</BaseLayout>

<script define:vars={{ countdown: copy.hero.countdown }}>
	// Live countdown in the deadline pill ("Noch 51 Tage"). The static badge
	// (31.12.2026) stays for no-JS and after the date has passed.
	const badge = document.querySelector('[data-deadline-pill] [data-pill-badge]');
	const days = Math.ceil((new Date(2027, 0, 1) - new Date()) / 86400000);
	if (badge && days > 0) badge.textContent = days === 1 ? countdown.one : countdown.many.replace('{n}', String(days));
</script>

<style>
	/* Ruled notebook lines behind the hero: the paper Berichtsheft, fading out */
	.bh-ruled {
		background-image: repeating-linear-gradient(to bottom, transparent 0 39px, rgba(255, 255, 255, 0.045) 39px 40px);
		mask-image: radial-gradient(ellipse 70% 65% at 70% 45%, black 20%, transparent 75%);
	}
	/* Staggered entrance */
	.bh-rise {
		animation: bh-rise 700ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
		animation-delay: var(--d, 0ms);
	}
	@keyframes bh-rise {
		from { opacity: 0; transform: translateY(14px); }
		to { opacity: 1; transform: none; }
	}
	@media (prefers-reduced-motion: reduce) {
		.bh-rise { animation: none; }
	}
</style>

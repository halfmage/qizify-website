---
// Three-step path from first call to everyday use. Plain list, no HowTo schema:
// this describes buying, not a task the visitor performs.
interface Step {
	title: string;
	body: string;
}

interface Props {
	label: string;
	headline: string;
	steps: Step[];
}

const { label, headline, steps } = Astro.props;
---

<section class="py-20 md:py-32 px-6 md:px-8" id="start">
	<div class="max-w-container mx-auto">
		<div class="text-center mb-14 md:mb-16">
			<span class="section-label mb-4 block">{label}</span>
			<h2 class="text-heading md:text-display-sm text-white m-0 max-w-[800px] mx-auto">{headline}</h2>
		</div>

		<ol class="grid grid-cols-1 md:grid-cols-3 gap-px bg-border rounded-xl overflow-hidden list-none m-0 p-0">
			{steps.map((step, index) => (
				<li class="bg-surface p-6 md:p-8 flex flex-col gap-3">
					<span class="font-mono text-label text-primary">0{index + 1}</span>
					<h3 class="text-lg font-semibold text-white m-0 leading-snug">{step.title}</h3>
					<p class="text-base leading-relaxed text-muted m-0">{step.body}</p>
				</li>
			))}
		</ol>
	</div>
</section>

---
interface Props {
	currentLang: 'en' | 'de';
}

const { currentLang } = Astro.props;

// BMWE logo with Förderzusatz, required by the IGP Zuwendungsbescheid (FKZ 16GM200301)
// on all project-related publicity. Shown in the footer on every page.
// Logo source: Wikimedia Commons.
const grant = currentLang === 'de'
	? 'Zuwendungsempfängerin: Alesia Kunz (Einzelunternehmen) · Förderkennzeichen 16GM200301'
	: 'Grant recipient: Alesia Kunz (sole proprietorship) · Grant 16GM200301';
---

<div class="flex flex-col md:flex-row md:items-center gap-3">
	<div class="bg-white rounded-lg px-5 py-3 flex flex-col items-start gap-1.5 text-left self-start">
		<p class="text-xs text-black leading-snug m-0">Gefördert durch:</p>
		<img
			src="/images/logos/bmwe-logo.svg"
			alt="Bundesministerium für Wirtschaft und Energie"
			class="h-14 w-auto"
			width="168"
			height="104"
			loading="lazy"
		/>
		<p class="text-xs text-black leading-snug m-0">aufgrund eines Beschlusses<br />des Deutschen Bundestages</p>
	</div>
	<p class="text-muted text-xs m-0">{grant}</p>
</div>

---
interface Props {
	currentLang: 'en' | 'de';
	// 'section' is the centered block on the research pages, 'footer' the compact
	// version shown on every page.
	variant?: 'section' | 'footer';
}

const { currentLang, variant = 'section' } = Astro.props;

// BMWE logo with Förderzusatz, required by the IGP Zuwendungsbescheid (FKZ 16GM200301)
// on all project-related publicity. Logo source: Wikimedia Commons.
const grant = currentLang === 'de' ? 'Förderkennzeichen 16GM200301' : 'Grant 16GM200301';
const isFooter = variant === 'footer';
---

<div class={isFooter ? 'flex flex-col md:flex-row md:items-center gap-3' : 'py-8 px-6 md:px-8'}>
	<div class={isFooter ? 'flex' : 'max-w-3xl mx-auto flex flex-col items-center gap-3 text-center'}>
		<div class="bg-white rounded-lg px-5 py-3 flex flex-col items-start gap-1.5 text-left">
			<p class="text-xs text-black leading-snug m-0">Gefördert durch:</p>
			<img
				src="/images/logos/bmwe-logo.svg"
				alt="Bundesministerium für Wirtschaft und Energie"
				class={isFooter ? 'h-14 w-auto' : 'h-20 w-auto'}
				width="168"
				height="104"
				loading="lazy"
			/>
			<p class="text-xs text-black leading-snug m-0">aufgrund eines Beschlusses<br />des Deutschen Bundestages</p>
		</div>
		{!isFooter && <p class="text-xs text-gray m-0">{grant}</p>}
	</div>
	{isFooter && <p class="text-muted text-xs m-0">{grant}</p>}
</div>

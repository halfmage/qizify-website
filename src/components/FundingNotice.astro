---
interface Props {
	currentLang: 'en' | 'de';
}

const { currentLang } = Astro.props;

// BMWE logo with Förderzusatz, required by the IGP Zuwendungsbescheid (FKZ 16GM200301)
// on all project-related publicity. Shown in the footer on every page.
// Logo source: Wikimedia Commons.
const recipient = currentLang === 'de'
	? 'Zuwendungsempfängerin: Alesia Kunz (Einzelunternehmen)'
	: 'Grant recipient: Alesia Kunz (sole proprietorship)';
const grantNumber = currentLang === 'de' ? 'Förderkennzeichen 16GM200301' : 'Grant 16GM200301';
---

<div class="flex flex-col sm:flex-row sm:items-end gap-4 sm:gap-6">
	{/* Official Förderzusatz layout: label above, logo, Bundestag line below. The SVG keeps its
	    built-in clear zone, so the captions are indented by the eagle's offset in the file (23/168). */}
	<div class="bg-white rounded-xl py-5 self-start shadow-sm ring-1 ring-black/5">
		<div class="w-[220px] text-left">
			<p class="text-[11px] text-neutral-700 leading-none m-0 pl-[13.75%]">Gefördert durch:</p>
			<img
				src="/images/logos/bmwe-logo.svg"
				alt="Bundesministerium für Wirtschaft und Energie"
				class="block w-full h-auto"
				width="220"
				height="136"
				loading="lazy"
			/>
			<p class="text-[11px] text-neutral-700 leading-snug m-0 pl-[13.75%]">aufgrund eines Beschlusses<br />des Deutschen Bundestages</p>
		</div>
	</div>
	<div class="text-muted text-xs leading-relaxed sm:pb-1">
		<p class="m-0">{recipient}</p>
		<p class="m-0">{grantNumber}</p>
	</div>
</div>

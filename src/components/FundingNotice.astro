---
interface Props {
	currentLang: 'en' | 'de';
}

const { currentLang } = Astro.props;

// BMWE logo with Förderzusatz, required by the IGP Zuwendungsbescheid (FKZ 16GM200301)
// on all project-related publicity. Shown in the footer on every page.
// Logo source: Wikimedia Commons.
const recipient = currentLang === 'de'
	? 'Zuwendungsempfängerin: Alesia Kunz (Einzelunternehmen)'
	: 'Grant recipient: Alesia Kunz (sole proprietorship)';
const grantNumber = currentLang === 'de' ? 'Förderkennzeichen 16GM200301' : 'Grant 16GM200301';
---

<div class="flex flex-col gap-2">
	{/* Official Förderzusatz layout: label above, logo, Bundestag line below, aligned with the eagle.
	    The SVG file stays unaltered; the wrapper crops its built-in margin (viewBox 0 0 168 104)
	    to the artwork area (x 23..147, y 19..84), so all offsets are percentages of that crop. */}
	<div class="bg-white rounded-lg px-3.5 py-3 self-start shadow-sm ring-1 ring-black/5">
		<p class="text-[9px] text-neutral-700 leading-none m-0 mb-2">Gefördert durch:</p>
		<div class="relative w-[128px] aspect-[124/65] overflow-hidden">
			<img
				src="/images/logos/bmwe-logo.svg"
				alt="Bundesministerium für Wirtschaft und Energie"
				class="absolute max-w-none w-[135.48%] h-auto left-[-18.55%] top-[-29.23%]"
				width="244"
				height="151"
				loading="lazy"
			/>
		</div>
		<p class="text-[9px] text-neutral-700 leading-snug m-0 mt-2">aufgrund eines Beschlusses<br />des Deutschen Bundestages</p>
	</div>
	<div class="text-muted text-[11px] leading-relaxed">
		<p class="m-0">{recipient}</p>
		<p class="m-0">{grantNumber}</p>
	</div>
</div>

---
// Hero visual for /us: a looping tutor conversation in the product's own look.
// Each turn types the learner's question, streams the answer and then shows the
// source. With prefers-reduced-motion it shows the first turn, fully written.
// Reads ?academy= and ?color= like the demo, so personalized links match.
---

<div class="tca relative" aria-hidden="true">
	<div class="tca-glow"></div>

	<div class="tca-card">
		<div class="tca-head">
			<div class="tca-av">A</div>
			<div class="min-w-0">
				<p class="tca-name">Alex · AI tutor</p>
				<p class="tca-org" id="tca-org">Your academy</p>
			</div>
			<span class="tca-live"><span></span>Online</span>
		</div>

		<div class="tca-body">
			<div class="tca-q" id="tca-q"></div>
			<div class="tca-a-wrap">
				<div class="tca-a" id="tca-a"><span class="tca-typing"><i></i><i></i><i></i></span></div>
				<div class="tca-src" id="tca-src"><span>Source</span><b id="tca-src-text"></b></div>
			</div>
		</div>

		<div class="tca-input">
			<span>Ask Alex anything about your course</span>
			<span class="tca-send">
				<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
			</span>
		</div>
	</div>

	<div class="tca-plan">
		<p class="tca-plan-label">Learning plan</p>
		<p class="tca-plan-title">Module 3 · Security Architecture</p>
		<div class="tca-bar"><i></i></div>
		<p class="tca-plan-meta">4 of 8 sections · Next: PKI and certificates</p>
	</div>
</div>

<style>
	.tca {
		--tca-accent: #6d28d9;
		padding: 24px 0 114px 32px;
	}
	.tca-glow {
		position: absolute;
		inset: -40px -20px 0 0;
		background:
			radial-gradient(ellipse 60% 55% at 60% 40%, rgba(124, 92, 252, 0.35), transparent 70%),
			radial-gradient(ellipse 45% 40% at 20% 90%, rgba(244, 162, 97, 0.18), transparent 70%);
		filter: blur(30px);
		pointer-events: none;
	}
	.tca-card {
		position: relative;
		background: #fff;
		color: #16141d;
		border-radius: 20px;
		box-shadow: 0 30px 80px rgba(0, 0, 0, 0.45);
		overflow: hidden;
		font-family: inherit;
	}
	.tca-head {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 16px 20px;
		border-bottom: 1px solid #ebe9f1;
	}
	.tca-av {
		width: 32px;
		height: 32px;
		border-radius: 50%;
		background: #16141d;
		color: #fff;
		display: grid;
		place-items: center;
		font-weight: 700;
		font-size: 14px;
		flex: none;
	}
	.tca-name {
		font-weight: 700;
		font-size: 14px;
		margin: 0;
	}
	.tca-org {
		font-size: 12px;
		color: #676478;
		margin: 0;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.tca-live {
		margin-left: auto;
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-size: 12px;
		color: #15803d;
		font-weight: 600;
	}
	.tca-live span {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: #22c55e;
	}
	.tca-body {
		padding: 20px;
		min-height: 270px;
		display: flex;
		flex-direction: column;
		gap: 14px;
	}
	.tca-q {
		align-self: flex-end;
		max-width: 85%;
		background: var(--tca-accent);
		color: #fff;
		padding: 11px 15px;
		border-radius: 16px 16px 6px 16px;
		font-size: 14.5px;
		font-weight: 500;
		line-height: 1.45;
		min-height: 43px;
		transition: opacity 0.3s;
	}
	.tca-a-wrap {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 8px;
		transition: opacity 0.3s;
	}
	.tca-a {
		background: #f4f3f8;
		padding: 12px 15px;
		border-radius: 16px 16px 16px 6px;
		font-size: 14px;
		line-height: 1.55;
		color: #2a2733;
		max-width: 92%;
	}
	.tca-src {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 12px;
		color: #676478;
		opacity: 0;
		transform: translateY(4px);
		transition: opacity 0.35s, transform 0.35s;
	}
	.tca-src.show {
		opacity: 1;
		transform: none;
	}
	.tca-src b {
		background: #efe9fd;
		color: #5b21b6;
		padding: 2px 10px;
		border-radius: 99px;
		font-weight: 600;
	}
	.tca :global(.tca-typing) {
		display: inline-flex;
		gap: 4px;
		padding: 4px 0;
	}
	.tca :global(.tca-typing i) {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: #9895a7;
		animation: tca-blink 1s infinite;
	}
	.tca :global(.tca-typing i:nth-child(2)) {
		animation-delay: 0.15s;
	}
	.tca :global(.tca-typing i:nth-child(3)) {
		animation-delay: 0.3s;
	}
	@keyframes tca-blink {
		0%,
		100% {
			opacity: 0.3;
		}
		50% {
			opacity: 1;
		}
	}
	.tca-input {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 10px;
		margin: 0 20px 20px;
		border: 1px solid #d7d4e1;
		border-radius: 99px;
		padding: 6px 6px 6px 16px;
		font-size: 13px;
		color: #9895a7;
	}
	.tca-send {
		width: 32px;
		height: 32px;
		border-radius: 50%;
		background: var(--tca-accent);
		color: #fff;
		display: grid;
		place-items: center;
		flex: none;
	}
	.tca-plan {
		position: absolute;
		left: 0;
		bottom: 0;
		width: 250px;
		background: #1f1f23;
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 14px;
		padding: 14px 16px;
		box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
	}
	.tca-plan p {
		margin: 0;
	}
	.tca-plan-label {
		font-size: 11px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: #a1a1aa;
		font-weight: 600;
	}
	.tca-plan-title {
		font-size: 13.5px;
		color: #fafafa;
		font-weight: 600;
		margin-top: 4px !important;
	}
	.tca-bar {
		height: 5px;
		border-radius: 9px;
		background: rgba(255, 255, 255, 0.1);
		margin: 10px 0 8px;
		overflow: hidden;
	}
	.tca-bar i {
		display: block;
		height: 100%;
		width: 50%;
		border-radius: 9px;
		background: #f4a261;
	}
	.tca-plan-meta {
		font-size: 12px;
		color: #a1a1aa;
	}
</style>

<script>
	const TURNS = [
		{
			q: 'When do I use an IPS instead of an IDS?',
			a: 'An IDS watches traffic and raises an alert. An IPS sits inline, so it can also block the traffic before it reaches the server.',
			src: 'Module 3 · Network appliances · p. 31',
		},
		{
			q: 'How does my browser know a certificate is valid?',
			a: 'It follows the signatures up to a root CA it already trusts, then checks that the certificate hasn’t expired or been revoked.',
			src: 'Module 3 · PKI and certificates · p. 22',
		},
		{
			q: 'Quiz me on what I got wrong last week.',
			a: 'Here are 5 questions from Module 3. Two are on PKI and certificates, where you missed the most points last time.',
			src: 'Deep Dive · built from your Module 3 slides',
		},
	];

	const root = document.querySelector('.tca') as HTMLElement | null;
	const q = document.getElementById('tca-q');
	const a = document.getElementById('tca-a');
	const src = document.getElementById('tca-src');
	const srcText = document.getElementById('tca-src-text');
	const org = document.getElementById('tca-org');

	// Personalized links: same parameters as the demo.
	const params = new URLSearchParams(window.location.search);
	const academy = (params.get('academy') || '').trim().slice(0, 40);
	const color = (params.get('color') || '').replace('#', '');
	if (academy && org) org.textContent = academy;
	if (root && /^[0-9a-f]{6}$/i.test(color)) root.style.setProperty('--tca-accent', `#${color}`);

	const TYPING = '<span class="tca-typing"><i></i><i></i><i></i></span>';
	const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
	const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	function showStatic(turn: (typeof TURNS)[number]) {
		if (!q || !a || !src || !srcText) return;
		q.textContent = turn.q;
		a.textContent = turn.a;
		srcText.textContent = turn.src;
		src.classList.add('show');
	}

	async function play() {
		if (!q || !a || !src || !srcText) return;
		let i = 0;
		for (;;) {
			// Wait while the tab is hidden or the card is off screen.
			while (document.hidden || !visible) await sleep(500);
			const turn = TURNS[i % TURNS.length];
			const wrap = a.parentElement as HTMLElement;
			q.style.opacity = '1';
			wrap.style.opacity = '1';
			src.classList.remove('show');
			a.innerHTML = TYPING;
			q.textContent = '';
			for (let c = 1; c <= turn.q.length; c++) {
				q.textContent = turn.q.slice(0, c);
				await sleep(32);
			}
			await sleep(900);
			const words = turn.a.split(' ');
			for (let w = 1; w <= words.length; w++) {
				a.textContent = words.slice(0, w).join(' ');
				await sleep(55);
			}
			srcText.textContent = turn.src;
			src.classList.add('show');
			await sleep(4200);
			q.style.opacity = '0';
			wrap.style.opacity = '0';
			await sleep(400);
			i++;
		}
	}

	let visible = true;
	if (root && 'IntersectionObserver' in window) {
		new IntersectionObserver((entries) => {
			visible = entries[0].isIntersecting;
		}).observe(root);
	}

	if (reduce) showStatic(TURNS[0]);
	else play();
</script>
